# Copia in .env e compila. Non committare mai .env.

# TMDB — https://www.themoviedb.org/settings/api (gratuita, uso non commerciale).
# Basta UNA delle due: il "API Read Access Token" (v4, consigliato) oppure la "API Key" (v3).
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Last.fm — https://www.last.fm/api/account/create (gratuita, uso non commerciale). Opzionale.
LASTFM_API_KEY=

# Contatto inserito nello User-Agent delle richieste (richiesto dalla policy API di Wikipedia).
# Usa l'URL del repository o un indirizzo email.
CLASSIFICHE_CONTACT=
