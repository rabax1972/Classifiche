# Copia in .env e compila. Non committare mai .env.

# TMDB — https://www.themoviedb.org/settings/api (gratuita, uso non commerciale).
# Basta UNA delle due: il "API Read Access Token" (v4, consigliato) oppure la "API Key" (v3).
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Last.fm — https://www.last.fm/api/account/create (gratuita, uso non commerciale). Opzionale.
LASTFM_API_KEY=

# Contatto inserito nello User-Agent delle richieste (richiesto dalla policy API di Wikipedia).
# Usa l'URL del repository o un indirizzo email.
CLASSIFICHE_CONTACT=

# Trakt — https://trakt.tv/oauth/applications (solo per npm run import:trakt, uso personale). Opzionale.
# Client ID dell'app, nome utente del profilo pubblico e email dell'account del sito a cui sono destinate le spunte.
# Con tutte e tre, la build mette in /account/ il pulsante "Sincronizza con Trakt", visibile solo a quell'account
# (src/lib/trakt-sync.ts): nelle impostazioni dell'app Trakt il sito va aggiunto tra le "Javascript (CORS) origins".
TRAKT_CLIENT_ID=
TRAKT_USERNAME=
TRAKT_ACCOUNT=

# Google Analytics 4 (es. G-XXXXXXXXXX): solo nella build pubblicata (npm run dist:aruba) e solo dopo il consenso del visitatore
# (banner in src/layouts/Base.astro, src/lib/analytics.ts). Opzionale: senza, niente banner e niente Analytics.
GA_MEASUREMENT_ID=
