{
  "name": "classifiche-italia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "ingest": "tsx scripts/ingest.ts",
    "aggregate": "tsx scripts/aggregate.ts",
    "seed": "tsx scripts/seed.ts",
    "covers:album": "tsx scripts/album-covers.ts",
    "covers:libri": "tsx scripts/book-covers.ts",
    "tracks:album": "tsx scripts/album-tracks.ts",
    "info:canzoni": "tsx scripts/song-info.ts",
    "info:libri": "tsx scripts/book-info.ts",
    "info:film": "tsx scripts/movie-info.ts",
    "update": "npm run ingest && npm run aggregate && npm run info:canzoni && npm run info:libri && npm run info:film",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "astro": "^7.3.8",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12"
  }
