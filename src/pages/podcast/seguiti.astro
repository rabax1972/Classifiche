---
import MyPodcasts from '../../components/MyPodcasts.astro';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/data';

// Lista dei podcast seguiti: quelli con la spunta "Lo seguo" nella classifica Podcast (lista "podcast-seguiti" di
// src/lib/ticks.ts, salvata nell'account se collegato), anche importati dall'esportazione dei dati di Spotify (scripts/spotify-import.ts).
---

<Base title="I miei podcast" description="I podcast che segui, con la loro posizione nelle classifiche di oggi." current="podcast">
  <div class="mb-6 space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">I miei podcast</h1>
    <p class="max-w-3xl text-gray-700 dark:text-gray-300">
      I podcast che hai segnato con <strong>Lo seguo</strong> nella classifica{' '}
      <a class="text-indigo-700 underline dark:text-indigo-300" href={href('podcast/oggi')}>Podcast</a>, o importato dalla pagina{' '}
      <a class="text-indigo-700 underline dark:text-indigo-300" href={href('account')}>Account</a>. Nella classifica sono evidenziati in verde.
    </p>
    <p class="max-w-3xl text-sm text-gray-600 dark:text-gray-400">
      Senza account la lista resta solo in questo browser: <a class="underline" href={href('account')}>accedi</a> per ritrovarla su tutti i tuoi dispositivi.
    </p>
  </div>
  <MyPodcasts />
</Base>
