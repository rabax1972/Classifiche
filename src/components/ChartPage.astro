---
import Base from '../layouts/Base.astro';
import { formatDateTime, formatDay, getChart, href } from '../lib/data';
import { CATEGORIES, PERIODS, SOURCES } from '../lib/sources';
import { movieSubtitle, seriesSubtitle } from '../lib/aggregate';
import { PERIOD_IDS, type BookItem, type CategoryId, type ChartView, type MovieItem, type PeriodId, type SeriesItem } from '../lib/types';
import ChartTable from './ChartTable.astro';
import ArtistDialog from './ArtistDialog.astro';
import AuthorDialog from './AuthorDialog.astro';
import BookDialog from './BookDialog.astro';
import CreatorDialog from './CreatorDialog.astro';
import DirectorDialog from './DirectorDialog.astro';
import MovieDialog from './MovieDialog.astro';
import MyMovies from './MyMovies.astro';
import PodcastDialog from './PodcastDialog.astro';
import SeriesDialog from './SeriesDialog.astro';
import SongDialog from './SongDialog.astro';

interface Props {
  category: CategoryId;
  period: PeriodId;
}
const { category, period } = Astro.props;
const cfg = CATEGORIES[category];
const chart = getChart(category, period);
const views = chart?.views ?? [];
const books: BookItem[] = views.flatMap((v) =>
  v.entries.map((e) => ({ key: e.key, title: e.title, author: e.subtitle, cover: e.cover, sourceUrl: e.sourceUrl })),
);

const movies: MovieItem[] = views.flatMap((v) =>
  v.entries.map((e) => ({ key: e.key, title: e.title, ...movieSubtitle(e.subtitle), cover: e.cover, sourceUrl: e.sourceUrl })),
);

const series: SeriesItem[] = views.flatMap((v) =>
  v.entries.map((e) => ({ key: e.key, title: e.title, ...seriesSubtitle(e.subtitle), cover: e.cover, sourceUrl: e.sourceUrl, externalId: e.externalId })),
);

const badge: Record<ChartView['kind'], string> = {
  official: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
  daily: 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300',
  computed: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300',
};

function range(v: ChartView) {
  if (v.kind === 'official') return v.periodLabel;
  if (v.from === v.to) return `${v.periodLabel} · ${formatDay(v.to)}`;
  return `${v.periodLabel} · dal ${formatDay(v.from)} al ${formatDay(v.to)}`;
}
const title = `${cfg.label} – ${PERIODS[period].label}`;
/** Scheda "I miei visti" (MyMovies): solo nella pagina Film, mostrata a chi ha l'account. */
const seenTab = category === 'film';
---

<Base title={title} description={`Classifica ${cfg.label.toLowerCase()} in Italia: ${PERIODS[period].label.toLowerCase()}. ${cfg.description}`} current={category}>
  <div class="mb-6 space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">{cfg.label}</h1>
    <p class="text-gray-700 dark:text-gray-300">{cfg.description}</p>
    {cfg.note && <p class="max-w-3xl text-sm text-gray-600 dark:text-gray-400">{cfg.note}</p>}
    {category === 'serie-tv' && (
      <p>
        <a href={href('serie-tv/viste')} class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:underline dark:text-emerald-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
          Le mie serie viste →
        </a>
      </p>
    )}
    {category === 'libri' && (
      <p>
        <a href={href('libri-letti')} class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-700 hover:underline dark:text-sky-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6.5A2.5 2.5 0 0 0 4 21.5zM20 19v3H6.5"></path></svg>
          I miei libri letti →
        </a>
      </p>
    )}
    {category === 'podcast' && (
      <p>
        <a href={href('podcast/seguiti')} class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:underline dark:text-emerald-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8"></path></svg>
          I miei podcast →
        </a>
      </p>
    )}
  </div>

  <nav aria-label="Periodo" class="mb-6">
    <ul class="inline-flex flex-wrap gap-1 rounded-xl bg-gray-200/70 p-1 dark:bg-gray-800">
      {
        PERIOD_IDS.map((p) => (
          <li>
            <a
              href={href(`${category}/${p}`)}
              aria-current={p === period ? 'page' : undefined}
              class="block rounded-lg px-4 py-1.5 text-sm font-medium text-gray-700 hover:text-gray-900 aria-[current=page]:bg-white aria-[current=page]:text-gray-900 aria-[current=page]:shadow-sm dark:text-gray-300 dark:hover:text-white dark:aria-[current=page]:bg-gray-950 dark:aria-[current=page]:text-white"
            >
              {PERIODS[p].label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    chart?.stale && (
      <div role="status" class="mb-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
        La fonte giornaliera non è stata raggiungibile nell'ultimo aggiornamento: mostriamo l'ultimo snapshot valido, del <strong>{formatDay(chart.lastSnapshot)}</strong>.
      </div>
    )
  }

  {
    views.length === 0 ? (
      <div class="mb-6 rounded-xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center dark:border-gray-700 dark:bg-gray-900">
        <p class="text-lg font-semibold">Nessun dato disponibile per questo periodo</p>
        <p class="mx-auto mt-2 max-w-md text-gray-600 dark:text-gray-400">
          Le fonti di questa classifica non hanno ancora fornito dati, oppure non sono configurate.
          Lo stato di ogni fonte è riportato nella pagina <a class="text-indigo-700 underline dark:text-indigo-300" href={href('fonti')}>Fonti e metodo</a>.
        </p>
      </div>
    ) : (
      <div class="views" data-views={views.length}>
        {(views.length > 1 || seenTab) && (
          <div role="tablist" aria-label="Tipo di classifica" class="views-tabs mb-4 hidden gap-2 border-b border-gray-200 dark:border-gray-800">
            {views.map((v, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${i}`}
                aria-controls={`panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab-key={v.sources[0] === 'imdb' || cfg.viewPerSource ? v.sources[0] : undefined}
                class="-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 aria-selected:border-indigo-600 aria-selected:text-indigo-700 dark:text-gray-400 dark:hover:text-white dark:aria-selected:border-indigo-400 dark:aria-selected:text-indigo-300"
              >
                {v.label}
              </button>
            ))}
            {seenTab && (
              <button
                type="button"
                role="tab"
                id="tab-visti"
                aria-controls="panel-visti"
                data-tab-key="visti"
                aria-selected="false"
                tabindex={-1}
                data-account-only
                hidden
                class="-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 aria-selected:border-indigo-600 aria-selected:text-indigo-700 dark:text-gray-400 dark:hover:text-white dark:aria-selected:border-indigo-400 dark:aria-selected:text-indigo-300"
              >
                I miei visti
              </button>
            )}
          </div>
        )}
        {views.map((v, i) => (
          <section id={`panel-${i}`} role={views.length > 1 || seenTab ? 'tabpanel' : undefined} aria-labelledby={views.length > 1 || seenTab ? `tab-${i}` : undefined} class="views-panel mb-10">
            <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${badge[v.kind]}`}>{v.label}</span>
              <span class="font-medium">{range(v)}</span>
              <span class="text-gray-600 dark:text-gray-400">
                Fonte:{' '}
                {v.sources.map((s, j) => (
                  <>
                    {j > 0 && ', '}
                    <a href={SOURCES[s]?.homepage} class="underline" rel="noopener" target="_blank">{SOURCES[s]?.name ?? s}</a>
                  </>
                ))}
              </span>
            </div>
            {v.note && <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">{v.note}</p>}
            <ChartTable view={v} category={category} caption={`${cfg.label}: ${v.label}, ${range(v)}`} />
          </section>
        ))}
        {seenTab && (
          <section id="panel-visti" role="tabpanel" aria-labelledby="tab-visti" class="views-panel mb-10" data-account-only hidden>
            <MyMovies list="visti" />
          </section>
        )}
      </div>
    )
  }

  {
    category === 'canzoni' && views.length > 0 && (
      <>
        <SongDialog views={views} />
        <ArtistDialog views={views} />
      </>
    )
  }
  {
    category === 'libri' && views.length > 0 && (
      <>
        <BookDialog books={books} />
        <AuthorDialog books={books} />
      </>
    )
  }
  {
    (category === 'cinema' || category === 'film') && views.length > 0 && (
      <>
        <MovieDialog movies={movies} />
        <DirectorDialog movies={movies} />
      </>
    )
  }
  {
    category === 'serie-tv' && views.length > 0 && (
      <>
        <SeriesDialog series={series} />
        <CreatorDialog series={series} />
      </>
    )
  }

  {category === 'podcast' && views.length > 0 && <PodcastDialog views={views} />}

  {chart && <p class="text-sm text-gray-600 dark:text-gray-400">Ultimo aggiornamento: {formatDateTime(chart.generatedAt)}{chart.lastSnapshot && ` · ultimo snapshot del ${formatDay(chart.lastSnapshot)}`}.</p>}
</Base>

<script>
  import { cachedAccount } from '../lib/account';

  // Schede "Ufficiale" / "Calcolata" / "IMDb Top 100" (e "I miei visti" per chi ha l'account): senza JS le classifiche sono mostrate una sotto l'altra.
  const TAB_KEY = 'vista:scheda-classifica';
  for (const root of document.querySelectorAll<HTMLElement>('.views')) {
    const tablist = root.querySelector<HTMLElement>('.views-tabs');
    if (!tablist) continue;
    const account = Boolean(cachedAccount());
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role=tab]')].filter((t) => account || !('accountOnly' in t.dataset));
    const panels = [...root.querySelectorAll<HTMLElement>('.views-panel')].filter((p) => account || !('accountOnly' in p.dataset));
    for (const t of tabs) t.hidden = false;
    if (tabs.length < 2) continue;
    tablist.classList.remove('hidden');
    tablist.classList.add('flex');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i]!.focus();
      // "I miei visti" e "IMDb Top 100", uguali per tutti i periodi, restano aperte passando da un periodo all'altro.
      try {
        sessionStorage.setItem(TAB_KEY, tabs[i]!.dataset.tabKey ?? '');
      } catch {
        // Storage non disponibile.
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight') select((i + 1) % n, true);
        else if (e.key === 'ArrowLeft') select((i - 1 + n) % n, true);
        else if (e.key === 'Home') select(0, true);
        else if (e.key === 'End') select(n - 1, true);
        else return;
        e.preventDefault();
      });
    });
    let start = 0;
    // Link diretto a una scheda (es. "#imdb" dalla home page), altrimenti quella rimasta aperta.
    const linked = tabs.findIndex((t) => t.dataset.tabKey && `#${t.dataset.tabKey}` === location.hash);
    if (linked >= 0) start = linked;
    else {
      try {
        const kept = sessionStorage.getItem(TAB_KEY);
        if (kept) start = Math.max(0, tabs.findIndex((t) => t.dataset.tabKey === kept));
      } catch {
        // Storage non disponibile.
      }
    }
    select(start);
  }
</script>
