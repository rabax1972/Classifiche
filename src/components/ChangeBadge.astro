---
import type { Change } from '../lib/types';

interface Props {
  change: Change | null;
}
const { change } = Astro.props;
---

{
  change === null ? (
    <span class="text-gray-400 dark:text-gray-600" aria-label="Variazione non disponibile">–</span>
  ) : change.kind === 'new' ? (
    <span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
      nuovo
    </span>
  ) : change.kind === 'same' ? (
    <span class="text-gray-500 dark:text-gray-400" aria-label="Posizione invariata">=</span>
  ) : change.kind === 'up' ? (
    <span class="font-semibold whitespace-nowrap text-emerald-700 dark:text-emerald-400" aria-label={`Salito di ${change.by}`}>
      <span aria-hidden="true">▲{change.by}</span>
    </span>
  ) : (
    <span class="font-semibold whitespace-nowrap text-rose-700 dark:text-rose-400" aria-label={`Sceso di ${change.by}`}>
      <span aria-hidden="true">▼{change.by}</span>
    </span>
  )
}
