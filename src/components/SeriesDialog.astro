---
// Modale con la scheda di una serie: si apre dai titoli della classifica Serie TV (pulsanti .series-open[data-serie]).
// I dati delle serie della pagina sono incorporati come JSON; il contenuto è costruito con textContent.
// Altre schede si aggiungono con l'evento SERIES_CARDS_EVENT (src/lib/dialogs.ts), es. dalla pagina "Le mie serie viste".
import { getSeriesInfo, seriesSeenKey } from '../lib/data';
import type { SeriesCard, SeriesItem } from '../lib/types';

interface Props {
  series: SeriesItem[];
}
const { series: items } = Astro.props;

const series: Record<string, SeriesCard> = {};
for (const { key, externalId, ...s } of items) series[key] ??= { ...s, seenKey: seriesSeenKey({ key, externalId }), info: getSeriesInfo(key) };
---

<script type="application/json" id="series-data" set:html={JSON.stringify(series).replace(/</g, '\\u003c')} />

<dialog
  id="series-dialog"
  aria-labelledby="series-title"
  class="m-auto w-[calc(100%-2rem)] max-w-3xl rounded-2xl bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm dark:bg-gray-900 dark:text-gray-100"
>
  <div data-scroll class="relative flex max-h-[90dvh] flex-col overflow-y-auto sm:flex-row">
    <button
      type="button"
      data-close
      class="absolute top-2 right-2 z-10 rounded-full bg-white/80 p-2 text-gray-700 hover:bg-white dark:bg-gray-900/80 dark:text-gray-200 dark:hover:bg-gray-800"
      aria-label="Chiudi"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>

    <div class="shrink-0 px-5 pt-5 sm:w-64 sm:bg-gray-100 sm:p-6 dark:sm:bg-gray-800">
      <img id="series-poster" alt="" referrerpolicy="no-referrer" class="mx-auto h-auto w-36 rounded-md shadow-lg sm:w-full" />
      <div id="series-poster-empty" class="mx-auto flex aspect-[2/3] w-36 items-center justify-center rounded-md bg-gray-100 text-4xl font-bold text-gray-400 sm:w-full dark:bg-gray-800 sm:dark:bg-gray-700" aria-hidden="true"></div>

      <!-- Stagioni: il clic apre gli episodi nella colonna di destra. -->
      <nav id="series-seasons-box" aria-labelledby="series-seasons-heading" class="mt-5">
        <h3 id="series-seasons-heading" class="text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400">Stagioni</h3>
        <ul id="series-seasons" class="mt-2 flex flex-wrap gap-1.5 sm:flex-col sm:gap-0.5"></ul>
      </nav>
    </div>

    <div class="min-w-0 flex-1 space-y-4 p-5 sm:p-6">
      <div id="series-main" class="space-y-4">
      <div class="pr-8">
        <h2 id="series-title" class="text-2xl leading-tight font-bold break-words"></h2>
        <p id="series-original" class="mt-0.5 text-sm text-gray-600 italic dark:text-gray-400"></p>
        <p id="series-creators-row" class="mt-1 text-lg text-gray-700 dark:text-gray-300">Creata da <span id="series-creators"></span></p>
        <p id="series-meta" class="mt-2 text-sm text-gray-600 dark:text-gray-400"></p>
        <p id="series-run" class="mt-1 text-sm text-gray-600 dark:text-gray-400"></p>
        <!-- Spunta condivisa con la classifica (src/lib/seen.ts). -->
        <label class="mt-3 inline-flex cursor-pointer items-center gap-2 rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium select-none has-checked:border-emerald-600 has-checked:bg-emerald-50 has-checked:text-emerald-800 dark:border-gray-700 dark:has-checked:border-emerald-600 dark:has-checked:bg-emerald-950/40 dark:has-checked:text-emerald-200">
          <input id="series-seen" type="checkbox" class="size-4 cursor-pointer accent-emerald-600" />
          L'ho vista
        </label>
      </div>

      <p id="series-tagline" class="border-l-4 border-indigo-300 pl-3 text-sm text-gray-700 italic dark:border-indigo-700 dark:text-gray-300"></p>

      <div>
        <h3 class="text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400">Trama</h3>
        <div id="series-desc" class="mt-1 space-y-2 text-sm leading-relaxed text-gray-800 dark:text-gray-200"></div>
      </div>

      <div id="series-cast-box">
        <h3 class="text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400">Interpreti</h3>
        <ul id="series-cast" class="mt-1 grid grid-cols-1 gap-x-4 gap-y-0.5 text-sm sm:grid-cols-2"></ul>
      </div>

      <div id="series-watch-box">
        <h3 class="text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400">Dove vederla in Italia</h3>
        <div id="series-watch" class="mt-1 space-y-2 text-sm"></div>
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          Disponibilità in streaming fornita da <a class="underline" href="https://www.justwatch.com/it" rel="noopener" target="_blank">JustWatch</a>.
        </p>
      </div>

      <div class="flex flex-wrap gap-2 text-sm font-medium">
        <a id="series-trailer" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-2 text-white hover:bg-indigo-700" rel="noopener" target="_blank">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          Guarda il trailer
        </a>
        <a id="series-tmdb" class="rounded-lg border border-gray-300 px-3 py-2 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" rel="noopener" target="_blank">Su TMDB</a>
        <a id="series-source" class="rounded-lg border border-gray-300 px-3 py-2 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" rel="noopener" target="_blank">Top 10 Netflix</a>
      </div>
      </div>

      <div id="series-episodes-view" class="space-y-3" hidden>
        <button id="series-back" type="button" class="inline-flex cursor-pointer items-center gap-1 rounded-lg py-1 pr-2 text-sm font-medium text-indigo-700 hover:underline dark:text-indigo-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          Scheda della serie
        </button>
        <div class="pr-8">
          <p id="series-ep-show" class="text-sm text-gray-600 dark:text-gray-400"></p>
          <h3 id="series-ep-title" tabindex="-1" class="text-xl leading-tight font-bold outline-none"></h3>
          <p id="series-ep-meta" class="mt-0.5 text-sm text-gray-600 dark:text-gray-400"></p>
          <!-- Episodi visti della stagione (spunte in src/lib/ticks.ts, lista "episodi-visti"). -->
          <div id="series-ep-progress" class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" hidden>
            <span id="series-ep-count" class="font-medium text-emerald-800 tabular-nums dark:text-emerald-300" aria-live="polite"></span>
            <button id="series-ep-all" type="button" class="cursor-pointer rounded-lg border border-gray-300 px-2.5 py-1 text-xs font-medium hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"></button>
          </div>
        </div>
        <!-- Episodi scaricati alla scelta della stagione (src/pages/serie-tv/episodi/[id]/[stagione].json.ts). -->
        <div id="series-episodes" aria-live="polite"></div>
      </div>

      <p class="text-xs text-gray-500 dark:text-gray-400">
        Dati da <a class="underline" href="https://www.themoviedb.org/" rel="noopener" target="_blank">TMDB</a>.
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
    </div>
  </div>
</dialog>

<!-- Dopo "Vista" su una serie (dalla classifica o dalla scheda): proposta di segnare come visti anche tutti gli episodi già usciti. -->
<dialog
  id="series-all-episodes"
  aria-labelledby="series-all-episodes-title"
  aria-describedby="series-all-episodes-text"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-white p-6 text-gray-900 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm dark:bg-gray-900 dark:text-gray-100"
>
  <h2 id="series-all-episodes-title" class="text-lg leading-tight font-bold">Segnare come visti anche gli episodi?</h2>
  <p id="series-all-episodes-text" class="mt-2 text-sm text-gray-700 dark:text-gray-300"></p>
  <form method="dialog" class="mt-5 flex flex-wrap justify-end gap-2">
    <button value="no" class="cursor-pointer rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800">
      Solo la serie
    </button>
    <button value="si" autofocus class="cursor-pointer rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500">
      Sì, tutti gli episodi
    </button>
  </form>
</dialog>

<script>
  import { SERIES_CARDS_EVENT, providerRow, setArtistButtons, setParagraphs, setupDialog } from '../lib/dialogs';
  import { SEEN_CHOICE_EVENT, SEEN_EVENT, seenKeys, setSeen, type SeenChange } from '../lib/seen';
  import { TICK_EVENT, getTicks, setTick, setTicks, type TickChange } from '../lib/ticks';
  import { SERIES_STATUS, type EpisodeInfo, type SeasonEpisodes, type SeasonSummary, type SeriesCard } from '../lib/types';

  const dialog = document.querySelector<HTMLDialogElement>('#series-dialog');
  const dataEl = document.querySelector('#series-data');
  if (dialog && dataEl) {
    const series = JSON.parse(dataEl.textContent || '{}') as Record<string, SeriesCard>;
    const creators = JSON.parse(document.querySelector('#creator-data')?.textContent || '{}') as Record<string, unknown>;
    const $ = <T extends HTMLElement>(id: string) => dialog.querySelector<T>(`#${id}`)!;
    const dateFmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const numFmt = new Intl.NumberFormat('it-IT');
    const day = (d: string) => dateFmt.format(new Date(`${d}T00:00:00Z`));
    const setLink = (el: HTMLAnchorElement, url: string, label: string) => {
      el.href = url;
      el.setAttribute('aria-label', `${label} (si apre in una nuova scheda)`);
    };
    const plural = (n: number, one: string, many: string) => `${numFmt.format(n)} ${n === 1 ? one : many}`;
    const shortFmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const today = new Date().toISOString().slice(0, 10);
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    // ---- Stagioni ed episodi: un file JSON per stagione, scaricato una volta sola.
    const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    const seasonFiles = new Map<string, Promise<SeasonEpisodes | null>>();
    const loadSeason = (id: number, n: number) => {
      const url = `${BASE}serie-tv/episodi/${id}/${n}.json`;
      if (!seasonFiles.has(url))
        seasonFiles.set(
          url,
          fetch(url)
            .then((r) => (r.ok ? (r.json() as Promise<SeasonEpisodes>) : null))
            .catch(() => null),
        );
      return seasonFiles.get(url)!;
    };

    // ---- Episodi visti: chiave "idTMDB:stagione:episodio", comune a tutte le pagine (e all'account).
    const EPISODES_STORE = 'episodi-visti';
    const episodeKey = (id: number, season: number, n: number) => `${id}:${season}:${n}`;
    const aired = (e: EpisodeInfo) => Boolean(e.date && e.date <= today);
    const SEEN_CARD = ['border-emerald-300', 'bg-emerald-50/60', 'dark:border-emerald-900', 'dark:bg-emerald-950/30'];
    const showEpisodeSeen = (box: HTMLInputElement, seen: boolean) => {
      box.checked = seen;
      const details = box.closest('li')!.querySelector('details')!;
      for (const c of SEEN_CARD) details.classList.toggle(c, seen);
    };

    /** Scheda di un episodio: casella "Visto" e riga con numero, titolo e data; aperta, fotogramma, dati, trama, regia e sceneggiatura. */
    const episodeCard = (e: EpisodeInfo, seasonN: number, id: number, seen: Set<string>) => {
      const details = el('details', 'group min-w-0 flex-1 rounded-lg border border-gray-200 open:bg-gray-50 dark:border-gray-800 dark:open:bg-gray-800/40');
      const summary = el('summary', 'flex cursor-pointer list-none items-baseline gap-2 px-3 py-2 text-sm [&::-webkit-details-marker]:hidden');
      const upcoming = !aired(e);
      const code = seasonN ? `${seasonN}×${String(e.n).padStart(2, '0')}` : `Sp. ${e.n}`;
      summary.append(
        el('span', 'w-12 shrink-0 text-xs text-gray-500 tabular-nums dark:text-gray-400', code),
        el('span', 'min-w-0 flex-1 font-medium break-words', e.title),
        el('span', `shrink-0 text-xs ${upcoming ? 'font-medium text-indigo-700 dark:text-indigo-300' : 'text-gray-500 dark:text-gray-400'}`, e.date ? (upcoming ? `in arrivo, ${shortFmt.format(new Date(`${e.date}T00:00:00Z`))}` : shortFmt.format(new Date(`${e.date}T00:00:00Z`))) : 'data da annunciare'),
      );
      const chevron = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      chevron.setAttribute('viewBox', '0 0 24 24');
      chevron.setAttribute('fill', 'none');
      chevron.setAttribute('stroke', 'currentColor');
      chevron.setAttribute('stroke-width', '2');
      chevron.setAttribute('aria-hidden', 'true');
      chevron.setAttribute('class', 'h-4 w-4 shrink-0 self-center text-gray-400 transition-transform group-open:rotate-180');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', 'm6 9 6 6 6-6');
      chevron.append(path);
      summary.append(chevron);
      details.append(summary);

      // Il contenuto si costruisce alla prima apertura (le stagioni lunghe hanno decine di episodi).
      details.addEventListener(
        'toggle',
        () => {
          const body = el('div', 'flex flex-col gap-3 px-3 pb-3 sm:flex-row');
          if (e.still) {
            const img = el('img', 'aspect-video w-full rounded-md bg-gray-200 object-cover sm:w-48 sm:shrink-0 sm:self-start dark:bg-gray-700');
            img.src = e.still;
            img.alt = `Fotogramma di ${e.title}`;
            img.loading = 'lazy';
            img.referrerPolicy = 'no-referrer';
            body.append(img);
          }
          const text = el('div', 'min-w-0 flex-1 space-y-1.5 text-sm');
          const meta = [
            e.date ? dateFmt.format(new Date(`${e.date}T00:00:00Z`)) : null,
            e.runtime ? `${e.runtime} min` : null,
            e.vote && e.votes >= 5 ? `Voto TMDB ${e.vote.toLocaleString('it-IT')}/10 (${numFmt.format(e.votes)} voti)` : null,
          ].filter(Boolean);
          if (meta.length) text.append(el('p', 'text-xs text-gray-600 dark:text-gray-400', meta.join(' · ')));
          const plot = el('div', 'space-y-1.5 leading-relaxed text-gray-800 dark:text-gray-200');
          if (e.overview) {
            setParagraphs(plot, e.overview);
            if (e.overviewLang === 'en') plot.lang = 'en';
          } else setParagraphs(plot, 'Trama non disponibile.', 'text-gray-600 dark:text-gray-400');
          text.append(plot);
          for (const [label, list] of [
            ['Regia', e.directors],
            ['Sceneggiatura', e.writers],
          ] as const)
            if (list.length) {
              const p = el('p', 'text-xs text-gray-600 dark:text-gray-400');
              p.append(el('span', 'font-medium', `${label}: `), list.join(', '));
              text.append(p);
            }
          body.append(text);
          details.append(body);
        },
        { once: true },
      );
      // Fuori dal <summary>, così il clic sulla casella non apre la scheda. Gli episodi non ancora usciti non si possono spuntare.
      const label = el('label', `flex shrink-0 items-center px-1 py-2.5 ${upcoming ? 'cursor-not-allowed opacity-40' : 'cursor-pointer'}`);
      const box = el('input', 'size-4 cursor-[inherit] accent-emerald-600');
      box.type = 'checkbox';
      box.dataset.episode = episodeKey(id, seasonN, e.n);
      box.disabled = upcoming;
      box.title = upcoming ? 'Non ancora uscito' : 'Visto';
      box.setAttribute('aria-label', `Visto: ${code} ${e.title}`);
      box.addEventListener('change', () => setTick(EPISODES_STORE, box.dataset.episode!, box.checked));
      label.append(box);
      const li = el('li', 'flex items-start gap-1');
      li.append(label, details);
      showEpisodeSeen(box, seen.has(box.dataset.episode));
      return li;
    };

    const mainView = $('series-main');
    const episodesView = $('series-episodes-view');
    const seasonsList = $('series-seasons');
    const episodesBox = $('series-episodes');
    /** Serie e stagione richieste per ultime: una risposta arrivata in ritardo non sovrascrive quella giusta. */
    let wanted = '';
    const markSeason = (n: number | null) => {
      for (const b of seasonsList.querySelectorAll<HTMLButtonElement>('button')) {
        if (b.dataset.season === String(n)) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      }
    };
    const showMain = () => {
      wanted = '';
      markSeason(null);
      mainView.hidden = false;
      episodesView.hidden = true;
    };
    $('series-back').addEventListener('click', () => {
      const selected = seasonsList.querySelector<HTMLButtonElement>('[aria-current]');
      showMain();
      dialog.querySelector('[data-scroll]')?.scrollTo(0, 0);
      selected?.focus();
    });

    const showSeason = async (id: number, title: string, season: SeasonSummary) => {
      const token = (wanted = `${id}/${season.n}`);
      markSeason(season.n);
      mainView.hidden = true;
      episodesView.hidden = false;
      $('series-ep-show').textContent = title;
      $('series-ep-title').textContent = season.name;
      $('series-ep-meta').textContent = [season.date ? day(season.date) : null, plural(season.episodes, 'episodio', 'episodi')].filter(Boolean).join(' · ');
      // In alto la stagione scelta (su schermi stretti la colonna di destra sta sotto l'elenco delle stagioni).
      episodesView.scrollIntoView({ block: 'start' });
      $('series-ep-title').focus({ preventScroll: true });

      shown = null;
      $('series-ep-progress').hidden = true;
      episodesBox.replaceChildren(el('p', 'text-sm text-gray-600 dark:text-gray-400', 'Caricamento degli episodi…'));
      const data = await loadSeason(id, season.n);
      if (token !== wanted) return;
      if (!data?.episodes.length) {
        episodesBox.replaceChildren(el('p', 'text-sm text-gray-600 dark:text-gray-400', 'Gli episodi di questa stagione non sono ancora disponibili: saranno completati nei prossimi aggiornamenti.'));
        return;
      }
      const seen = getTicks(EPISODES_STORE);
      const list = el('ol', 'space-y-1.5');
      list.setAttribute('aria-label', `Episodi: ${season.name}`);
      list.append(...data.episodes.map((e) => episodeCard(e, season.n, id, seen)));
      episodesBox.replaceChildren(list);
      shown = { id, season: season.n, keys: data.episodes.filter(aired).map((e) => episodeKey(id, season.n, e.n)) };
      updateProgress();
    };

    /** Stagione mostrata: chiavi degli episodi già usciti, per il conteggio e "Segna tutti come visti". */
    let shown: { id: number; season: number; keys: string[] } | null = null;
    const allButton = $<HTMLButtonElement>('series-ep-all');
    const updateProgress = () => {
      const box = $('series-ep-progress');
      box.hidden = !shown?.keys.length;
      if (!shown?.keys.length) return;
      const seen = getTicks(EPISODES_STORE);
      const have = shown.keys.filter((k) => seen.has(k)).length;
      const total = shown.keys.length;
      $('series-ep-count').textContent = have === total ? `Tutti visti (${total})` : `${have} di ${total} ${total === 1 ? 'visto' : 'visti'}`;
      allButton.textContent = have === total ? 'Togli tutte le spunte' : 'Segna tutti come visti';
      allButton.dataset.mark = String(have !== total);
    };
    allButton.addEventListener('click', () => {
      if (shown) setTicks(EPISODES_STORE, shown.keys, allButton.dataset.mark === 'true');
    });

    // Serie segnata come vista: se ha episodi già usciti non ancora spuntati, si propone di segnarli tutti (speciali esclusi).
    const bySeenKey = new Map(Object.values(series).map((s) => [s.seenKey, s]));
    // Schede arrivate dopo il caricamento della pagina (es. il catalogo delle serie viste).
    document.addEventListener(SERIES_CARDS_EVENT, (ev) => {
      const cards = (ev as CustomEvent<Record<string, SeriesCard>>).detail;
      Object.assign(series, cards);
      for (const s of Object.values(cards)) if (!bySeenKey.has(s.seenKey)) bySeenKey.set(s.seenKey, s);
      linked.openLinked();
    });
    const confirmAll = document.querySelector<HTMLDialogElement>('#series-all-episodes')!;
    document.addEventListener(SEEN_CHOICE_EVENT, async (ev) => {
      const { list, key, seen } = (ev as CustomEvent<SeenChange>).detail;
      const s = list === 'serie' && seen ? bySeenKey.get(key) : undefined;
      const info = s?.info;
      if (!s || !info) return;
      const seasons = info.seasonList.filter((x) => x.n > 0 && x.episodes > 0);
      const files = await Promise.all(seasons.map((x) => loadSeason(info.tmdbId, x.n)));
      const done = getTicks(EPISODES_STORE);
      const missing = files.flatMap((f, i) =>
        (f?.episodes ?? []).filter(aired).map((e) => episodeKey(info.tmdbId, seasons[i]!.n, e.n)).filter((k) => !done.has(k)),
      );
      // Niente da proporre, o spunta già tolta mentre si scaricavano le stagioni.
      if (!missing.length || !seenKeys('serie').has(key) || confirmAll.open) return;
      const inSeasons = new Set(missing.map((k) => k.split(':')[1])).size;
      confirmAll.querySelector('#series-all-episodes-text')!.textContent =
        `Hai segnato «${s.title}» come vista. Vuoi segnare come ` +
        (missing.length === 1 ? "visto anche l'unico episodio già uscito che non hai ancora spuntato" : `visti anche i ${numFmt.format(missing.length)} episodi già usciti che non hai ancora spuntato`) +
        (inSeasons > 1 ? `, in ${plural(inSeasons, 'stagione', 'stagioni')}?` : '?');
      confirmAll.querySelector('button[value=si]')!.textContent = missing.length === 1 ? "Sì, anche l'episodio" : 'Sì, tutti gli episodi';
      confirmAll.returnValue = '';
      confirmAll.showModal();
      confirmAll.addEventListener('close', () => confirmAll.returnValue === 'si' && setTicks(EPISODES_STORE, missing, true), { once: true });
    });

    /** Episodi visti di una stagione, accanto al nome nell'elenco delle stagioni. */
    const seasonSeen = (id: number, n: number, seen = getTicks(EPISODES_STORE)) => {
      const prefix = `${id}:${n}:`;
      let count = 0;
      for (const k of seen) if (k.startsWith(prefix)) count++;
      return count;
    };
    const updateSeasonCounts = () => {
      const seen = getTicks(EPISODES_STORE);
      for (const span of seasonsList.querySelectorAll<HTMLElement>('[data-seen-count]')) {
        const n = seasonSeen(Number(span.dataset.id), Number(span.dataset.season), seen);
        span.textContent = n ? `✓ ${n}` : '';
        span.hidden = !n;
      }
    };

    // Spunta cambiata qui, da "Segna tutti" o arrivata dall'account (src/lib/ticks.ts).
    document.addEventListener(TICK_EVENT, (ev) => {
      const { store, key, on } = (ev as CustomEvent<TickChange>).detail;
      if (store !== EPISODES_STORE) return;
      const box = episodesBox.querySelector<HTMLInputElement>(`input[data-episode="${CSS.escape(key)}"]`);
      if (box) showEpisodeSeen(box, on);
      updateProgress();
      updateSeasonCounts();
    });

    // Serie mostrata nella modale, per la spunta "L'ho vista" (chiave comune a tutte le stagioni).
    let current: string | null = null;
    const seenBox = $<HTMLInputElement>('series-seen');
    seenBox.addEventListener('change', () => current && setSeen('serie', current, seenBox.checked));
    document.addEventListener(SEEN_EVENT, (ev) => {
      const { list, key, seen } = (ev as CustomEvent<SeenChange>).detail;
      if (list === 'serie' && key === current) seenBox.checked = seen;
    });

    const render = (key: string) => {
      const s = series[key];
      if (!s) return false;
      const info = s.info;
      showMain();
      current = s.seenKey;
      seenBox.checked = seenKeys('serie').has(s.seenKey);

      $('series-title').textContent = s.label ? `${s.title} · ${s.label}` : s.title;
      $('series-original').textContent = info?.originalTitle ? `Titolo originale: ${info.originalTitle}` : '';
      $('series-original').hidden = !info?.originalTitle;

      const who = s.creators ?? (info?.creators.map((c) => c.name).join(', ') || null);
      $('series-creators-row').hidden = !who;
      setArtistButtons($('series-creators'), who, (k) => k in creators, { trigger: 'creator-open', name: 'creatore' });

      const poster = info?.poster ?? s.cover?.replace('/w185/', '/w500/') ?? null;
      const img = $<HTMLImageElement>('series-poster');
      img.hidden = !poster;
      img.src = poster ?? '';
      img.alt = poster ? `Locandina di ${s.title}` : '';
      const empty = $('series-poster-empty');
      empty.hidden = Boolean(poster);
      empty.textContent = s.title.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');

      const meta = [
        info?.genres.slice(0, 3).join(', ') || null,
        info?.seasons ? plural(info.seasons, 'stagione', 'stagioni') : null,
        info?.episodes ? plural(info.episodes, 'episodio', 'episodi') : null,
        info?.episodeRuntime ? `episodi da ${info.episodeRuntime} min` : null,
        info?.vote && info.votes >= 10 ? `Voto TMDB ${info.vote.toLocaleString('it-IT')}/10 (${numFmt.format(info.votes)} voti)` : null,
      ].filter(Boolean);
      $('series-meta').textContent = meta.join(' · ');
      $('series-meta').hidden = !meta.length;

      // In onda: anni, stato, reti e prossimo episodio.
      const from = info?.firstAired?.slice(0, 4) ?? s.year;
      const to = info?.lastAired?.slice(0, 4);
      const ended = info?.status === 'Ended' || info?.status === 'Canceled';
      const run = [
        from ? (ended && to && to !== from ? `${from}–${to}` : from) : null,
        info?.status ? (SERIES_STATUS[info.status] ?? info.status) : null,
        info?.networks.length ? info.networks.join(', ') : null,
        info?.nextEpisode
          ? `prossimo episodio (S${info.nextEpisode.season} E${info.nextEpisode.episode}) il ${day(info.nextEpisode.date)}`
          : null,
      ].filter(Boolean);
      $('series-run').textContent = run.join(' · ');
      $('series-run').hidden = !run.length;

      const seasons = info?.seasonList ?? [];
      $('series-seasons-box').hidden = !seasons.length;
      seasonsList.replaceChildren(
        ...seasons.map((x) => {
          const li = el('li');
          const b = el(
            'button',
            'group flex cursor-pointer items-baseline justify-between gap-2 rounded-full bg-gray-100 px-3 py-1 text-left text-sm hover:bg-indigo-50 hover:text-indigo-700 aria-[current=true]:bg-indigo-600 aria-[current=true]:text-white sm:w-full sm:rounded-lg sm:bg-transparent sm:py-1.5 dark:bg-gray-800 dark:hover:bg-indigo-950 dark:hover:text-indigo-300 sm:dark:bg-transparent dark:aria-[current=true]:bg-indigo-500 dark:aria-[current=true]:text-white',
          );
          b.type = 'button';
          b.dataset.season = String(x.n);
          const seenCount = el('span', 'ml-auto shrink-0 text-xs font-medium text-emerald-700 tabular-nums group-aria-[current=true]:text-white dark:text-emerald-400');
          if (info) Object.assign(seenCount.dataset, { seenCount: '', id: String(info.tmdbId), season: String(x.n) });
          seenCount.setAttribute('aria-hidden', 'true');
          const seen = info ? seasonSeen(info.tmdbId, x.n) : 0;
          seenCount.textContent = seen ? `✓ ${seen}` : '';
          seenCount.hidden = !seen;
          b.append(
            el('span', 'font-medium', x.name),
            seenCount,
            el('span', 'hidden shrink-0 text-xs text-gray-500 tabular-nums group-aria-[current=true]:text-indigo-100 sm:inline dark:text-gray-400', [x.date?.slice(0, 4), `${x.episodes} ep.`].filter(Boolean).join(' · ')),
          );
          b.setAttribute('aria-label', `${x.name}: ${plural(x.episodes, 'episodio', 'episodi')}${x.date ? `, dal ${x.date.slice(0, 4)}` : ''}`);
          b.addEventListener('click', () => info && showSeason(info.tmdbId, s.title, x));
          li.append(b);
          return li;
        }),
      );

      $('series-tagline').textContent = info?.tagline ?? '';
      $('series-tagline').hidden = !info?.tagline;

      const desc = $('series-desc');
      desc.removeAttribute('lang');
      if (info?.overview) {
        setParagraphs(desc, info.overview);
        if (info.overviewLang === 'en') desc.lang = 'en';
      } else {
        setParagraphs(
          desc,
          info ? 'Non abbiamo trovato una trama di questa serie.' : 'La scheda di questa serie non è ancora disponibile: sarà completata nei prossimi aggiornamenti.',
          'text-gray-600 dark:text-gray-400',
        );
      }

      const cast = info?.cast ?? [];
      $('series-cast-box').hidden = !cast.length;
      $('series-cast').replaceChildren(
        ...cast.map((c) => {
          const li = document.createElement('li');
          li.textContent = c.name;
          if (c.character) {
            const role = document.createElement('span');
            role.className = 'text-gray-500 dark:text-gray-400';
            role.textContent = ` · ${c.character}`;
            li.append(role);
          }
          return li;
        }),
      );

      const watch = info?.watch;
      $('series-watch-box').hidden = !watch;
      if (watch) {
        const rows = (
          [
            ['Abbonamento', watch.flatrate],
            ['Noleggio', watch.rent],
            ['Acquisto', watch.buy],
          ] as const
        )
          .filter(([, list]) => list.length)
          .map(([label, list]) => providerRow(label, list));
        const more = document.createElement('a');
        more.className = 'inline-block text-indigo-700 underline dark:text-indigo-300';
        more.rel = 'noopener';
        more.target = '_blank';
        more.textContent = 'Tutte le offerte';
        setLink(more, watch.link, `Dove vedere ${s.title}: tutte le offerte su TMDB`);
        $('series-watch').replaceChildren(...rows, more);
      }

      const trailer = $<HTMLAnchorElement>('series-trailer');
      trailer.hidden = !info?.trailer;
      if (info?.trailer) setLink(trailer, `https://www.youtube.com/watch?v=${encodeURIComponent(info.trailer)}`, `Trailer di ${s.title} su YouTube`);

      const tmdbUrl = info ? `https://www.themoviedb.org/tv/${info.tmdbId}` : s.sourceUrl?.includes('themoviedb.org') ? s.sourceUrl : null;
      const tmdb = $<HTMLAnchorElement>('series-tmdb');
      tmdb.hidden = !tmdbUrl;
      if (tmdbUrl) setLink(tmdb, tmdbUrl, `${s.title} su TMDB`);
      const netflix = s.sourceUrl?.includes('netflix.com') ? s.sourceUrl : null;
      const source = $<HTMLAnchorElement>('series-source');
      source.hidden = !netflix;
      if (netflix) setLink(source, netflix, `Classifica Netflix con ${s.title}`);
      return true;
    };

    // Link diretto a una serie: /serie-tv/#serie=<chiave>
    const linked = setupDialog({ dialog, name: 'serie', trigger: 'series-open', render });
  }
</script>
