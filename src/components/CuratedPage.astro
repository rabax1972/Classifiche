---
import Base from '../layouts/Base.astro';
import { getCuratedList } from '../lib/data';
import type { CuratedId } from '../lib/types';
import Cover from './Cover.astro';

interface Props {
  id: CuratedId;
  /** Copertine verticali (libri) invece che quadrate (album). */
  poster?: boolean;
}
const { id, poster = false } = Astro.props;
const list = getCuratedList(id);

function linkLabel(url: string): string {
  const host = new URL(url).host;
  if (host === 'music.apple.com') return 'Ascolta su Apple Music';
  if (host === 'books.apple.com') return 'Su Apple Books';
  if (host === 'openlibrary.org') return 'Scheda su Open Library';
  return 'Scheda';
}
---

<Base title={list.title} description={list.intro} current={id}>
  <header class="mb-8 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{list.title}</h1>
    <p class="mt-3 text-lg text-gray-700 dark:text-gray-300">{list.intro}</p>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      Lista: <a href={list.listUrl} class="underline" rel="noopener" target="_blank">{list.listSource}</a>. Descrizioni a cura di Classifiche Italia.{' '}
      {list.coversNote}
    </p>
  </header>

  <ol class="grid gap-4 lg:grid-cols-2">
    {
      list.entries.map((e) => (
        <li id={`n${e.rank}`} class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
          <div class="relative shrink-0">
            <Cover src={e.cover ?? null} title={e.title} size={poster ? 96 : 112} poster={poster} />
            <span class="absolute -top-2 -left-2 flex h-8 min-w-8 items-center justify-center rounded-full bg-indigo-700 px-1.5 text-sm font-bold text-white tabular-nums shadow">
              {e.rank}
            </span>
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="font-bold leading-snug">{e.title}</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              {e.creator} · {e.year}
            </p>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">{e.description}</p>
            {e.url && (
              <a href={e.url} class="mt-2 inline-block text-sm font-semibold text-indigo-700 hover:underline dark:text-indigo-300" rel="noopener" target="_blank">
                {linkLabel(e.url)}<span class="sr-only">: {e.title}</span> →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Base>
