---
import Base from '../layouts/Base.astro';
import { artistKey, normalizeText, splitArtists } from '../lib/aggregate';
import { getAuthorInfo, getCuratedGroup, getCuratedList, href } from '../lib/data';
import type { BookItem, CuratedId, CuratedTrack } from '../lib/types';
import AuthorDialog from './AuthorDialog.astro';
import BookDialog from './BookDialog.astro';
import Cover from './Cover.astro';

interface Props {
  id: CuratedId;
  /** Copertine verticali (libri) invece che quadrate (album). */
  poster?: boolean;
}
const { id, poster = false } = Astro.props;
// Chiave stabile per le spunte salvate nel browser: non cambia se la lista viene riordinata.
// È anche la chiave delle schede dei libri (scripts/book-info.ts, curatedKey).
const itemKey = (e: { creator: string; title: string }) => `${normalizeText(e.creator)}|${normalizeText(e.title)}`;
const list = getCuratedList(id);
const siblings = list.group ? getCuratedGroup(list.group) : [];
// Le liste di un gruppo condividono le spunte: un libro presente in entrambe risulta posseduto in tutte e due.
const storeId = list.group ?? id;
// Liste di libri: il titolo apre la scheda del libro (BookDialog), ogni autore la propria (AuthorDialog).
const books = id.startsWith('libri-');
const bookItems: BookItem[] = books
  ? list.entries.map((e) => ({ key: itemKey(e), title: e.title, author: e.creator, cover: e.cover ?? null, sourceUrl: e.url ?? null, year: e.year, description: e.description }))
  : [];
/** "A e B" resta intero solo se è un unico autore con una voce su Wikipedia. */
const oneAuthor = (name: string) => Boolean(getAuthorInfo(artistKey(name))?.wiki);
const hasAuthorCard = (name: string) => Boolean(name.trim()) && !/^autori vari$/i.test(name.trim());

function linkLabel(url: string): string {
  const host = new URL(url).host;
  if (host === 'music.apple.com') return 'Ascolta su Apple Music';
  if (host === 'books.apple.com') return 'Su Apple Books';
  if (host === 'openlibrary.org') return 'Scheda su Open Library';
  return 'Scheda';
}

const spotifySearch = (q: string) => `https://open.spotify.com/search/${encodeURIComponent(q)}`;
/** music.apple.com/it/album/titolo/123?i=456 → music.apple.com/it/album/123?i=456 (Apple reindirizza). */
const shortApple = (url: string) => url.replace(/\/album\/[^/]+\/(\d+)/, '/album/$1');
const appleSearch = (q: string) => `https://music.apple.com/it/search?term=${encodeURIComponent(q)}`;
const geniusSearch = (q: string) => `https://genius.com/search?q=${encodeURIComponent(q)}`;
/** "Come Together - 2019 Mix" → "Come Together": le note sulle riedizioni non servono nella tracklist. */
const trackTitle = (t: string) =>
  t
    .replace(/\s+-\s+(\d{4}\s+)?(remaster(ed)?|mono|stereo|\d{4} mix|single version)\b.*$/i, '')
    .replace(/\s*[([](\d{4}\s+)?(remaster(ed)?|\d{4} mix)[^)\]]*[)\]]/gi, '')
    .trim();
function minSec(ms: number): string {
  const s = Math.round(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
}
function totalTime(tracks: CuratedTrack[]): string {
  const min = Math.round(tracks.reduce((sum, t) => sum + (t.ms ?? 0), 0) / 60000);
  if (!min) return '';
  return min >= 60 ? ` · ${Math.floor(min / 60)} h ${min % 60} min` : ` · ${min} min`;
}
/** Brani raggruppati per disco. */
function discs(tracks: CuratedTrack[]): { disc: number | null; tracks: CuratedTrack[] }[] {
  const groups = new Map<number | null, CuratedTrack[]>();
  for (const t of tracks) groups.set(t.disc ?? null, [...(groups.get(t.disc ?? null) ?? []), t]);
  return [...groups].map(([disc, tracks]) => ({ disc, tracks }));
}


const FILTERS = [
  { id: 'tutti', label: 'Tutti' },
  { id: 'mancanti', label: 'Mancanti' },
  { id: 'posseduti', label: "Ce l'ho" },
] as const;
---

<Base title={list.title} description={list.intro} current={list.group ?? id}>
  {
    siblings.length > 1 && (
      <nav aria-label="Scegli la lista" class="mb-6">
        <ul class="inline-flex flex-wrap gap-1 rounded-xl border border-gray-300 bg-white p-1 text-sm font-medium dark:border-gray-700 dark:bg-gray-900">
          {siblings.map((l) => (
            <li>
              <a
                href={href(l.path)}
                aria-current={l.id === id ? 'page' : undefined}
                class="block rounded-lg px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-700 aria-[current=page]:text-white dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-600"
              >
                {l.tabLabel ?? l.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <header class="mb-6 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{list.title}</h1>
    <p class="mt-3 text-lg text-gray-700 dark:text-gray-300">{list.intro}</p>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      Lista: <a href={list.listUrl} class="underline" rel="noopener" target="_blank">{list.listSource}</a>. Descrizioni a cura di Classifiche Italia.{' '}
      {list.coversNote}
    </p>
  </header>

  <div data-curated={id} data-store={storeId}>
    <!-- Visibile solo con JavaScript attivo: le spunte vivono nel localStorage del browser e nell'account (src/lib/ticks.ts). -->
    <div data-toolbar hidden class="sticky top-0 z-10 -mx-4 mb-4 border-b border-gray-200 bg-gray-50/95 px-4 py-3 backdrop-blur dark:border-gray-800 dark:bg-gray-950/95">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <div role="group" aria-label="Filtra la lista" class="inline-flex rounded-lg border border-gray-300 bg-white p-0.5 text-sm font-medium dark:border-gray-700 dark:bg-gray-900">
          {
            FILTERS.map((f) => (
              <button
                type="button"
                data-filter={f.id}
                aria-pressed={f.id === 'tutti' ? 'true' : 'false'}
                class="rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-pressed:bg-indigo-700 aria-pressed:text-white dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-pressed:bg-indigo-600"
              >
                {f.label} <span data-count={f.id} class="tabular-nums opacity-80"></span>
              </button>
            ))
          }
        </div>
        <div class="flex min-w-40 flex-1 items-center gap-3">
          <div class="h-2 flex-1 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800" aria-hidden="true">
            <div data-progress class="h-full rounded-full bg-emerald-600 transition-[width]" style="width:0%"></div>
          </div>
          <p data-summary class="text-sm whitespace-nowrap text-gray-700 tabular-nums dark:text-gray-300" aria-live="polite"></p>
        </div>
      </div>
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        Le spunte restano salvate in questo browser{siblings.length > 1 && ' e valgono per tutte le liste: un titolo presente in più liste risulta spuntato ovunque'}.
        <a href={href('account')} class="underline">Con un account</a> le ritrovi su tutti i tuoi dispositivi.
      </p>
    </div>

    <p data-empty hidden class="py-12 text-center text-gray-600 dark:text-gray-400"></p>

    <ol class="grid items-start gap-4 lg:grid-cols-2">
      {
        list.entries.map((e) => (
          <li
            id={`n${e.rank}`}
            data-key={itemKey(e)}
            class="group flex scroll-mt-32 gap-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm data-owned:border-emerald-500 data-owned:bg-emerald-50/60 dark:border-gray-800 dark:bg-gray-900 dark:data-owned:border-emerald-600 dark:data-owned:bg-emerald-950/30"
          >
            <div class="relative shrink-0">
              <Cover src={e.cover ?? null} title={e.title} size={poster ? 96 : 112} poster={poster} />
              <span class="absolute -top-2 -left-2 flex h-8 min-w-8 items-center justify-center rounded-full bg-indigo-700 px-1.5 text-sm font-bold text-white tabular-nums shadow group-data-owned:bg-emerald-600">
                {e.rank}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="font-bold leading-snug">
                {books ? (
                  <button
                    type="button"
                    class="book-open cursor-pointer text-left decoration-indigo-400 underline-offset-2 hover:text-indigo-700 hover:underline dark:hover:text-indigo-300"
                    data-libro={itemKey(e)}
                    aria-haspopup="dialog"
                  >
                    {e.title}
                  </button>
                ) : (
                  e.title
                )}
              </h2>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                {books
                  ? splitArtists(e.creator, oneAuthor).map((part, j) =>
                      j % 2 === 1 || !hasAuthorCard(part) ? (
                        part
                      ) : (
                        <button
                          type="button"
                          class="author-open cursor-pointer text-left underline-offset-2 hover:text-indigo-700 hover:underline dark:hover:text-indigo-300"
                          data-autore={artistKey(part)}
                          aria-haspopup="dialog"
                        >
                          {part}
                        </button>
                      ),
                    )
                  : e.creator}{' '}
                · {e.year}
              </p>
              <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">{e.description}</p>
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
                <label data-owned-toggle hidden class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 select-none dark:text-gray-300">
                  <input type="checkbox" class="size-4 cursor-pointer accent-emerald-600" />
                  Ce l'ho<span class="sr-only">: {e.title}</span>
                </label>
                {e.url && (
                  <a href={e.url} class="text-sm font-semibold text-indigo-700 hover:underline dark:text-indigo-300" rel="noopener" target="_blank">
                    {linkLabel(e.url)}
                    <span class="sr-only">: {e.title}</span> →
                  </a>
                )}
                {e.tracks && (
                  <a href={spotifySearch(`${e.title} ${e.creator}`)} class="text-sm font-semibold text-indigo-700 hover:underline dark:text-indigo-300" rel="noopener" target="_blank">
                    Cerca su Spotify<span class="sr-only">: {e.title}</span> →
                  </a>
                )}
              </div>
              {e.tracks && e.tracks.length > 0 && (
                <details class="mt-3 rounded-lg border border-gray-200 dark:border-gray-800">
                  <summary class="cursor-pointer px-3 py-2 text-sm font-semibold text-gray-800 select-none hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-800/60">
                    Brani ({e.tracks.length}){totalTime(e.tracks)}
                  </summary>
                  <div class="border-t border-gray-200 px-3 pb-2 dark:border-gray-800">
                    {discs(e.tracks).map(({ disc, tracks }) => (
                      <>
                        {disc !== null && <p class="pt-3 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Disco {disc}</p>}
                        {/* Righe con classi brevi (stile in fondo al file): le pagine album hanno oltre mille brani. */}
                        <ol class="trk">
                          {tracks.map((t) => {
                            const name = trackTitle(t.title);
                            return (
                              <li>
                                <i>{t.n}</i>
                                <span>{name}</span>
                                {t.ms && <i>{minSec(t.ms)}</i>}
                                <a class="am" href={t.url ? shortApple(t.url) : appleSearch(`${name} ${e.creator}`)} aria-label={`Apple Music: ${name}`}>
                                  Apple
                                </a>
                                <a class="sp" href={spotifySearch(`${name} ${e.creator}`)} aria-label={`Spotify: ${name}`}>
                                  Spotify
                                </a>
                                <a class="gn" href={geniusSearch(`${name} ${e.creator}`)} aria-label={`Testo su Genius: ${name}`}>
                                  Testo
                                </a>
                              </li>
                            );
                          })}
                        </ol>
                      </>
                    ))}
                  </div>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  {
    books && (
      <>
        <BookDialog books={bookItems} />
        <AuthorDialog books={bookItems} booksLabel="In questa lista" />
      </>
    )
  }
</Base>

<style is:global>
  /* Tracklist degli album: niente classi Tailwind sulle singole righe, per contenere il peso della pagina. */
  .trk {
    font-size: var(--text-sm);
  }
  .trk li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0;
    color: var(--color-gray-800);
  }
  .trk li + li {
    border-top: 1px solid var(--color-gray-100);
  }
  .trk i {
    flex-shrink: 0;
    font-style: normal;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-gray-500);
  }
  .trk i:first-child {
    width: 1.25rem;
    text-align: right;
  }
  .trk span {
    flex: 1;
    min-width: 0;
  }
  .trk a {
    flex-shrink: 0;
    padding: 0 0.25rem;
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .trk a:hover {
    text-decoration: underline;
  }
  .trk .am {
    color: var(--color-rose-700);
  }
  .trk .sp {
    color: var(--color-emerald-700);
  }
  .trk .gn {
    color: var(--color-amber-700);
  }
  .dark .trk li {
    color: var(--color-gray-200);
  }
  .dark .trk li + li {
    border-color: var(--color-gray-800);
  }
  .dark .trk i {
    color: var(--color-gray-400);
  }
  .dark .trk .am {
    color: var(--color-rose-400);
  }
  .dark .trk .sp {
    color: var(--color-emerald-400);
  }
  .dark .trk .gn {
    color: var(--color-amber-400);
  }
</style>

<style is:global>
  [data-curated][data-view='mancanti'] li[data-owned],
  [data-curated][data-view='posseduti'] li:not([data-owned]) {
    display: none;
  }
</style>

<script>
  import { TICK_EVENT, getTicks, setTick, type TickChange } from '../lib/ticks';

  // I link dei brani si aprono in una nuova scheda (attributi aggiunti qui per non ripeterli su ogni riga).
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.trk a')) {
    a.target = '_blank';
    a.rel = 'noopener';
  }

  type View = 'tutti' | 'mancanti' | 'posseduti';

  function read<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }
  function write(key: string, value: unknown) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // Storage non disponibile (es. navigazione privata): il filtro scelto vale solo per questa visita.
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-curated]')) {
    const id = root.dataset.curated!;
    const ownedKey = `posseduti:${root.dataset.store!}`;
    const viewKey = `vista:${id}`;
    const owned = getTicks(ownedKey);
    const items = [...root.querySelectorAll<HTMLLIElement>('li[data-key]')];
    const total = items.length;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;

    const render = () => {
      const have = items.filter((li) => owned.has(li.dataset.key!)).length;
      const counts: Record<View, number> = { tutti: total, mancanti: total - have, posseduti: have };
      for (const [view, n] of Object.entries(counts)) root.querySelector(`[data-count="${view}"]`)!.textContent = `(${n})`;
      root.querySelector<HTMLElement>('[data-progress]')!.style.width = `${(have / total) * 100}%`;
      root.querySelector('[data-summary]')!.textContent = `${have} su ${total}`;
      const view = (root.dataset.view ?? 'tutti') as View;
      empty.hidden = counts[view] > 0;
      empty.textContent = view === 'mancanti' ? 'Li hai tutti!' : 'Non hai ancora spuntato nessun titolo.';
    };

    for (const li of items) {
      const key = li.dataset.key!;
      const label = li.querySelector<HTMLElement>('[data-owned-toggle]')!;
      const box = label.querySelector('input')!;
      label.hidden = false;
      box.checked = owned.has(key);
      li.toggleAttribute('data-owned', box.checked);
      box.addEventListener('change', () => setTick(ownedKey, key, box.checked));
    }
    // Spunta cambiata qui o arrivata dall'account (src/lib/ticks.ts).
    document.addEventListener(TICK_EVENT, (ev) => {
      const { store, key, on } = (ev as CustomEvent<TickChange>).detail;
      if (store !== ownedKey) return;
      if (on) owned.add(key);
      else owned.delete(key);
      for (const li of items) {
        if (li.dataset.key !== key) continue;
        li.toggleAttribute('data-owned', on);
        li.querySelector<HTMLInputElement>('[data-owned-toggle] input')!.checked = on;
      }
      render();
    });

    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const setView = (view: View) => {
      root.dataset.view = view;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === view));
      write(viewKey, view);
      render();
    };
    for (const b of buttons) b.addEventListener('click', () => setView(b.dataset.filter as View));

    root.querySelector<HTMLElement>('[data-toolbar]')!.hidden = false;
    setView(read<View>(viewKey, 'tutti'));
  }
</script>
