---
// Lista "I miei libri letti" (pagina /libri-letti/): tutti i libri spuntati come letti (lista "letti"), anche fuori dalla
// classifica e dalle liste, con ricerca, filtri (anno di lettura, voto) e ordinamento per titolo, autore, data di lettura o
// voto. I dati arrivano da /libri/catalogo.json (src/pages/libri/catalogo.json.ts), scaricato all'apertura della pagina.
import { href } from '../lib/data';

const filterSelect = 'rounded-lg border border-gray-300 bg-white py-2 pr-8 pl-3 text-sm dark:border-gray-700 dark:bg-gray-900';
---

<div class="my-books" data-src={href('libri/catalogo.json')}>
  <p class="my-status py-6 text-center text-gray-600 dark:text-gray-400" aria-live="polite">Caricamento dei libri letti…</p>

  <div class="my-body" hidden>
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <label class="relative min-w-0 flex-1 sm:max-w-xs">
        <span class="sr-only">Cerca tra i libri letti</span>
        <svg class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input
          type="search"
          data-search
          class="w-full rounded-lg border border-gray-300 bg-white py-2 pr-3 pl-9 text-sm placeholder:text-gray-500 dark:border-gray-700 dark:bg-gray-900"
          placeholder="Cerca per titolo o autore…"
          autocomplete="off"
        />
      </label>
      <label class="flex items-center gap-2 text-sm">
        <span class="text-gray-600 dark:text-gray-400">Ordina per</span>
        <select class={filterSelect} data-sort>
          <option value="letto-desc">Letti di recente</option>
          <option value="letto-asc">Letti da più tempo</option>
          <option value="titolo">Titolo (A–Z)</option>
          <option value="autore">Autore (A–Z)</option>
          <option value="voto">Il mio voto (dal più alto)</option>
        </select>
      </label>
      <p class="my-count text-sm text-gray-600 dark:text-gray-400" aria-live="polite"></p>
    </div>

    <div class="mb-3 flex flex-wrap items-center gap-2" role="group" aria-label="Filtra i libri letti">
      <label>
        <span class="sr-only">Anno di lettura</span>
        <select class={filterSelect} data-filter="anno">
          <option value="">Letti in qualsiasi anno</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Il mio voto minimo</span>
        <select class={filterSelect} data-filter="voto">
          <option value="">Qualsiasi voto</option>
          <option value="3">Voto 3 o più</option>
          <option value="4">Voto 4 o più</option>
          <option value="5">Voto 5</option>
        </select>
      </label>
      <button type="button" data-reset class="hidden rounded-lg px-3 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-950">
        Azzera filtri
      </button>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
      <ul class="my-list divide-y divide-gray-100 dark:divide-gray-800"></ul>
      <p class="my-empty hidden px-4 py-10 text-center text-gray-600 dark:text-gray-400">Nessun libro letto per questa ricerca o per questi filtri.</p>
    </div>
    <div class="mt-3 text-center">
      <button type="button" class="my-more hidden rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:hover:bg-gray-800"></button>
    </div>
    <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
      Copertine da <a class="underline" href="https://openlibrary.org/" rel="noopener" target="_blank">Open Library</a> e Apple Books.
    </p>
  </div>
</div>

<script>
  import { normalizeText } from '../lib/aggregate';
  import { batched, coverBox, el, nullsLast, pref } from '../lib/my-list';
  import { TICK_EVENT, getTicks, setTicks, type TickChange } from '../lib/ticks';
  import type { ReadBook } from '../lib/types';

  const STORE = 'letti';
  const PAGE = 60;
  const SORT_KEY = 'vista:ordine-letti';
  const MONTHS = ['gennaio', 'febbraio', 'marzo', 'aprile', 'maggio', 'giugno', 'luglio', 'agosto', 'settembre', 'ottobre', 'novembre', 'dicembre'];
  /** "2019-11-23" → "il 23 novembre 2019", "1997-02" → "a febbraio 1997", "2015" → "nel 2015". */
  const finishedText = (d: string) => {
    const [y, m, day] = d.split('-').map(Number);
    if (day) return `il ${day} ${MONTHS[m! - 1]} ${y}`;
    if (m) return `a ${MONTHS[m - 1]} ${y}`;
    return `nel ${y}`;
  };
  const stars = (rating: number) => '★'.repeat(Math.floor(rating)) + (rating % 1 ? '½' : '');

  for (const root of document.querySelectorAll<HTMLElement>('.my-books')) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const status = $('.my-status');
    const body = $('.my-body');
    const list = $('.my-list');
    const empty = $('.my-empty');
    const more = $<HTMLButtonElement>('.my-more');
    const count = $('.my-count');
    const search = $<HTMLInputElement>('[data-search]');
    const sort = $<HTMLSelectElement>('[data-sort]');
    const yearSelect = $<HTMLSelectElement>('[data-filter=anno]');
    const voteSelect = $<HTMLSelectElement>('[data-filter=voto]');
    const reset = $<HTMLButtonElement>('[data-reset]');

    let books: ReadBook[] = [];
    let mine: ReadBook[] = [];
    /** Libri appena tolti da qui: restano in elenco fino al prossimo cambio di filtri. */
    const removedHere = new Set<ReadBook>();
    let limit = PAGE;
    let changingHere = false;
    let loaded = false;

    const savedSort = pref.get(SORT_KEY);
    if ([...sort.options].some((o) => o.value === savedSort)) sort.value = savedSort;

    const isRead = (b: ReadBook, ticks: Set<string>) => b.keys.some((k) => ticks.has(k));
    const collect = () => {
      const ticks = getTicks(STORE);
      mine = books.filter((b) => isRead(b, ticks) || removedHere.has(b));
    };
    /** Anni di lettura presenti, dal più recente. */
    const buildYears = () => {
      const picked = yearSelect.value;
      const years = [...new Set(mine.map((b) => b.finished?.slice(0, 4)).filter(Boolean) as string[])].sort().reverse();
      yearSelect.replaceChildren(
        new Option('Letti in qualsiasi anno', ''),
        ...years.map((y) => new Option(`Letti nel ${y} (${mine.filter((b) => b.finished?.startsWith(y)).length})`, y)),
        ...(mine.some((b) => !b.finished) ? [new Option('Senza data di lettura', 'nessuna')] : []),
      );
      if ([...yearSelect.options].some((o) => o.value === picked)) yearSelect.value = picked;
    };

    const passes = (b: ReadBook, q: string) =>
      (!q || normalizeText(`${b.title} ${b.author}`).includes(q)) &&
      (!yearSelect.value || (yearSelect.value === 'nessuna' ? !b.finished : Boolean(b.finished?.startsWith(yearSelect.value)))) &&
      (!voteSelect.value || (b.rating ?? 0) >= Number(voteSelect.value));

    const it = (a: string, b: string) => a.localeCompare(b, 'it', { sensitivity: 'base', numeric: true });
    const byTitle = (a: ReadBook, b: ReadBook) => it(a.title, b.title);
    /** Cognome del primo autore, per l'ordine per autore. */
    const surname = (b: ReadBook) => b.author.split(',')[0]!.trim().split(' ').at(-1) ?? '';
    // Le date di lettura parziali ("2015", "1997-02") si ordinano come l'inizio del periodo.
    const sorters: Record<string, (a: ReadBook, b: ReadBook) => number> = {
      titolo: byTitle,
      autore: (a, b) => it(surname(a), surname(b)) || it(a.author, b.author) || byTitle(a, b),
      voto: (a, b) => nullsLast(a.rating, b.rating, -1) || byTitle(a, b),
      'letto-desc': (a, b) => nullsLast(a.finished, b.finished, -1) || byTitle(a, b),
      'letto-asc': (a, b) => nullsLast(a.finished, b.finished, 1) || byTitle(a, b),
    };

    const row = (b: ReadBook) => {
      const li = el('li', 'flex items-start gap-3 px-3 py-3');
      const text = el('div', 'min-w-0');
      text.append(el('p', 'font-semibold break-words', b.title));
      if (b.author) text.append(el('p', 'text-gray-600 break-words dark:text-gray-400', b.author));
      const details = [b.year ? String(b.year) : '', b.pages ? `${b.pages} pagine` : '', b.publisher ?? ''].filter(Boolean).join(' · ');
      if (details) text.append(el('p', 'text-xs text-gray-500 dark:text-gray-400', details));
      if (b.finished || b.rating) {
        const line = el('div', 'mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs');
        if (b.rating) {
          const badge = el('span', 'inline-flex items-center rounded-md bg-amber-50 px-1.5 py-0.5 font-semibold text-amber-700 ring-1 ring-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:ring-amber-900');
          badge.append(el('span', 'sr-only', `Il mio voto: ${String(b.rating).replace('.', ',')} su 5 `));
          const s = el('span', '', stars(b.rating));
          s.setAttribute('aria-hidden', 'true');
          badge.append(s);
          badge.title = `Il mio voto: ${String(b.rating).replace('.', ',')} su 5`;
          line.append(badge);
        }
        if (b.finished) line.append(el('span', 'text-gray-600 dark:text-gray-400', `Finito ${finishedText(b.finished)}`));
        text.append(line);
      }
      const label = el('label', 'mt-1 inline-flex cursor-pointer items-center gap-1.5 text-xs font-medium text-gray-700 select-none dark:text-gray-300');
      const box = el('input', 'size-3.5 cursor-pointer accent-sky-600');
      box.type = 'checkbox';
      box.checked = isRead(b, getTicks(STORE));
      box.addEventListener('change', () => {
        if (box.checked) removedHere.delete(b);
        else removedHere.add(b);
        changingHere = true;
        // Tolta da tutte le chiavi del libro (basta una per contarlo letto), messa sulla prima.
        setTicks(STORE, box.checked ? [b.keys[0]!] : b.keys, box.checked);
        changingHere = false;
        countText();
      });
      label.append(box, 'Letto', el('span', 'sr-only', `: ${b.title}`));
      text.append(label);
      li.append(coverBox(b.cover), text);
      return li;
    };

    let shown: ReadBook[] = [];
    const countText = () => {
      const ticks = getTicks(STORE);
      const total = mine.filter((b) => isRead(b, ticks)).length;
      count.textContent = shown.length === mine.length ? `${total} libri letti` : `${shown.length} su ${mine.length} libri`;
    };
    const render = () => {
      const q = normalizeText(search.value);
      shown = mine.filter((b) => passes(b, q)).sort(sorters[sort.value] ?? byTitle);
      list.replaceChildren(...shown.slice(0, limit).map(row));
      empty.classList.toggle('hidden', shown.length > 0);
      const rest = shown.length - limit;
      more.classList.toggle('hidden', rest <= 0);
      more.textContent = `Mostra altri ${Math.min(rest, PAGE)} (${Math.max(rest, 0)} ancora)`;
      reset.classList.toggle('hidden', !yearSelect.value && !voteSelect.value);
      countText();
    };
    const changed = () => {
      limit = PAGE;
      if (removedHere.size) {
        removedHere.clear();
        collect();
      }
      render();
    };
    const showAll = () => {
      collect();
      const any = mine.length > 0;
      status.hidden = any;
      body.hidden = !any;
      if (!any) status.textContent = 'Non hai ancora libri segnati come letti: spunta "Letto" nella classifica Libri o nelle liste "Libri da avere".';
      buildYears();
      render();
    };

    search.addEventListener('input', changed);
    sort.addEventListener('change', () => {
      pref.set(SORT_KEY, sort.value);
      changed();
    });
    yearSelect.addEventListener('change', changed);
    voteSelect.addEventListener('change', changed);
    reset.addEventListener('click', () => {
      yearSelect.value = '';
      voteSelect.value = '';
      changed();
    });
    more.addEventListener('click', () => {
      limit += PAGE;
      render();
    });
    // Spunte arrivate dall'account o da un'altra scheda del browser (un solo aggiornamento per una raffica di eventi).
    const refresh = batched(showAll);
    document.addEventListener(TICK_EVENT, (ev) => {
      if (changingHere || !loaded || (ev as CustomEvent<TickChange>).detail.store !== STORE) return;
      refresh();
    });

    void (async () => {
      try {
        const res = await fetch(root.dataset.src!);
        if (!res.ok) throw new Error(String(res.status));
        books = ((await res.json()) as { books: ReadBook[] }).books;
      } catch {
        status.textContent = 'Non è stato possibile caricare i libri letti: riprova più tardi.';
        return;
      }
      loaded = true;
      showAll();
    })();
  }
</script>
