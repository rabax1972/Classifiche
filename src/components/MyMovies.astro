---
// Liste personali di film: "I miei visti" (scheda della pagina Film, lista "visti") e "Da vedere" (pagina /da-vedere/, lista
// "da-vedere"). Tutti i film spuntati, anche fuori dalle classifiche, con ricerca, filtri (servizi, generi, durata, voto) e
// ordinamento per titolo, voto o anno. I dati arrivano da /film/catalogo.json (src/pages/film/catalogo.json.ts), scaricato solo
// quando la lista si mostra.
import { href } from '../lib/data';

interface Props {
  list: 'visti' | 'da-vedere';
}
const { list } = Astro.props;
const words =
  list === 'visti'
    ? { search: 'Cerca tra i film visti', loading: 'Caricamento dei film visti…', group: 'Filtra i film visti', none: 'Nessun film visto per questa ricerca o per questi filtri.' }
    : { search: 'Cerca nella lista', loading: 'Caricamento della lista…', group: 'Filtra i film da vedere', none: 'Nessun film da vedere per questa ricerca o per questi filtri.' };
const filterSelect = 'rounded-lg border border-gray-300 bg-white py-2 pr-8 pl-3 text-sm dark:border-gray-700 dark:bg-gray-900';
const multis = [
  { key: 'provider', all: 'Tutti i servizi', help: 'Film in abbonamento su almeno uno dei servizi scelti.' },
  { key: 'genre', all: 'Tutti i generi', help: 'Film di almeno uno dei generi scelti.' },
];
---

<div class="my-movies" data-src={href('film/catalogo.json')} data-list={list}>
  <p class="my-status py-6 text-center text-gray-600 dark:text-gray-400" aria-live="polite">{words.loading}</p>

  <div class="my-body" hidden>
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <label class="relative min-w-0 flex-1 sm:max-w-xs">
        <span class="sr-only">{words.search}</span>
        <svg class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input
          type="search"
          data-search
          class="w-full rounded-lg border border-gray-300 bg-white py-2 pr-3 pl-9 text-sm placeholder:text-gray-500 dark:border-gray-700 dark:bg-gray-900"
          placeholder="Cerca per titolo o regista…"
          autocomplete="off"
        />
      </label>
      <label class="flex items-center gap-2 text-sm">
        <span class="text-gray-600 dark:text-gray-400">Ordina per</span>
        <select class={filterSelect} data-sort>
          <option value="titolo">Titolo (A–Z)</option>
          <option value="voto">Voto (dal più alto)</option>
          <option value="anno-desc">Anno (dal più recente)</option>
          <option value="anno-asc">Anno (dal meno recente)</option>
        </select>
      </label>
      <p class="my-count text-sm text-gray-600 dark:text-gray-400" aria-live="polite"></p>
    </div>

    <div class="relative mb-3 flex flex-wrap items-center gap-2" role="group" aria-label={words.group}>
      {
        multis.map((m) => (
          <details class="sm:relative" data-multi={m.key} data-all={m.all}>
            <summary class={`${filterSelect} flex cursor-pointer list-none items-center gap-2 pr-3 [&::-webkit-details-marker]:hidden`}>
              <span data-multi-label>{m.all}</span>
              <svg class="h-4 w-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <div class="absolute top-full right-0 left-0 z-20 mt-1 max-h-80 overflow-y-auto rounded-xl border border-gray-200 bg-white p-3 shadow-lg sm:right-auto sm:w-[22rem] dark:border-gray-700 dark:bg-gray-900" role="group" aria-label={`${m.all}: scegline uno o più`}>
              <p class="mb-2 text-xs text-gray-600 dark:text-gray-400">{m.help}</p>
              <ul class="flex flex-wrap gap-1.5" data-options></ul>
            </div>
          </details>
        ))
      }
      <label>
        <span class="sr-only">Durata</span>
        <select class={filterSelect} data-filter="runtime">
          <option value="">Qualsiasi durata</option>
          <option value="0-90">Fino a 90 min</option>
          <option value="91-120">Da 90 min a 2 ore</option>
          <option value="121-999">Oltre 2 ore</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Voto TMDB minimo</span>
        <select class={filterSelect} data-filter="vote">
          <option value="">Qualsiasi voto</option>
          <option value="6">Voto 6 o più</option>
          <option value="7">Voto 7 o più</option>
          <option value="8">Voto 8 o più</option>
        </select>
      </label>
      <button type="button" data-reset class="hidden rounded-lg px-3 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-950">
        Azzera filtri
      </button>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
      <ul class="my-list divide-y divide-gray-100 dark:divide-gray-800"></ul>
      <p class="my-empty hidden px-4 py-10 text-center text-gray-600 dark:text-gray-400">{words.none}</p>
    </div>
    <div class="mt-3 text-center">
      <button type="button" class="my-more hidden rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:hover:bg-gray-800"></button>
    </div>
    <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
      Titoli, voti medi e locandine di <a class="underline" href="https://www.themoviedb.org/" rel="noopener" target="_blank">TMDB</a>; servizi in
      abbonamento in Italia forniti da <a class="underline" href="https://www.justwatch.com/it" rel="noopener" target="_blank">JustWatch</a> tramite TMDB.
    </p>
  </div>
</div>

<script>
  import { normalizeText } from '../lib/aggregate';
  import { TICK_EVENT, getTicks, setTicks, type TickChange } from '../lib/ticks';
  import type { SeenMovie } from '../lib/types';

  const SEEN = 'visti';
  const WATCH = 'da-vedere';
  const PAGE = 60;
  const voteText = (vote: number) => vote.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };
  const readPref = (key: string) => {
    try {
      return localStorage.getItem(key) ?? '';
    } catch {
      return '';
    }
  };
  const writePref = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Storage non disponibile (es. navigazione privata).
    }
  };
  const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  /**
   * Film senza scheda nel catalogo (es. uscito dalle classifiche da tempo): titolo, regista e anno ricavati dalla chiave
   * ("titolo|regista anno", normalizzati), così resta in lista e si può togliere.
   */
  function fromKey(key: string, id: number): SeenMovie {
    const [title = '', sub = ''] = key.split('|');
    const year = sub.match(/\b(\d{4})$/)?.[1];
    const director = sub.replace(/\s*\d{4}$/, '').split(' ').filter(Boolean).map(capitalize).join(' ');
    return { tmdbId: id, title: capitalize(title), year: year ? Number(year) : null, directors: director ? [director] : [], poster: null, vote: null, votes: 0, genres: [], runtime: null, providers: [], keys: [key] };
  }

  for (const root of document.querySelectorAll<HTMLElement>('.my-movies')) {
    const store = root.dataset.list === WATCH ? WATCH : SEEN;
    const sortKey = `vista:ordine-${store}`;
    // Nella pagina Film è una scheda (si carica quando si apre), nella pagina "Da vedere" è sempre visibile.
    const panel = root.closest<HTMLElement>('.views-panel');
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const status = $('.my-status');
    const body = $('.my-body');
    const list = $('.my-list');
    const empty = $('.my-empty');
    const more = $<HTMLButtonElement>('.my-more');
    const count = $('.my-count');
    const search = $<HTMLInputElement>('[data-search]');
    const sort = $<HTMLSelectElement>('[data-sort]');
    const selects = [...root.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const multis = [...root.querySelectorAll<HTMLDetailsElement>('[data-multi]')];
    const reset = $<HTMLButtonElement>('[data-reset]');
    /** Film che la pagina sa già mostrare nella propria modale (sono nelle classifiche qui sopra). */
    const inPage = new Set([...document.querySelectorAll<HTMLElement>('.movie-open[data-film]')].map((b) => b.dataset.film!));

    let films: SeenMovie[] = [];
    /** Film della lista (più quelli appena tolti da qui, che restano in elenco fino al prossimo cambio di filtri). */
    let mine: SeenMovie[] = [];
    const removedHere = new Set<number>();
    let limit = PAGE;
    let changingHere = false;

    const savedSort = readPref(sortKey);
    if ([...sort.options].some((o) => o.value === savedSort)) sort.value = savedSort;

    const has = (f: SeenMovie, keys: Set<string>) => f.keys.some((k) => keys.has(k));
    const collect = () => {
      const ticks = getTicks(store);
      mine = films.filter((f) => has(f, ticks) || removedHere.has(f.tmdbId));
      if (store === WATCH) {
        // Spunte senza scheda nel catalogo: si mostrano lo stesso, con i dati della chiave.
        const known = new Set(films.flatMap((f) => f.keys));
        [...ticks].filter((k) => !known.has(k)).forEach((k, i) => mine.push(fromKey(k, -1 - i)));
      }
    };
    const chosen = (m: HTMLDetailsElement) => [...m.querySelectorAll<HTMLButtonElement>('[aria-pressed=true]')].map((b) => b.dataset.value!);

    /** Voci dei filtri a scelta multipla, dalla più frequente; le scelte già fatte restano. */
    const buildOptions = () => {
      for (const m of multis) {
        const picked = new Set(chosen(m));
        const counts = new Map<string, { n: number; logo: string | null }>();
        for (const f of mine) {
          const values = m.dataset.multi === 'provider' ? f.providers : f.genres.map((name) => ({ name, logo: null }));
          for (const v of values) counts.set(v.name, { n: (counts.get(v.name)?.n ?? 0) + 1, logo: v.logo ?? counts.get(v.name)?.logo ?? null });
        }
        const ul = m.querySelector('[data-options]')!;
        ul.replaceChildren(
          ...[...counts]
            .sort((a, b) => b[1].n - a[1].n || a[0].localeCompare(b[0], 'it'))
            .map(([name, { n, logo }]) => {
              const li = el('li');
              const btn = el(
                'button',
                `inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-gray-300 py-1 text-sm hover:bg-gray-50 aria-pressed:border-indigo-600 aria-pressed:bg-indigo-600 aria-pressed:text-white dark:border-gray-700 dark:hover:bg-gray-800 dark:aria-pressed:border-indigo-500 dark:aria-pressed:bg-indigo-500 ${logo ? 'pr-3 pl-1' : 'px-3'}`,
              );
              btn.type = 'button';
              btn.dataset.value = name;
              btn.setAttribute('aria-pressed', String(picked.has(name)));
              if (logo) {
                const img = el('img', 'h-[22px] w-[22px] rounded-full');
                Object.assign(img, { src: logo, alt: '', width: 22, height: 22, loading: 'lazy', referrerPolicy: 'no-referrer' });
                btn.append(img);
              }
              btn.append(`${name} (${n})`);
              btn.addEventListener('click', () => {
                btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true'));
                changed();
              });
              li.append(btn);
              return li;
            }),
        );
      }
    };

    const passes = (f: SeenMovie, q: string) =>
      (!q || normalizeText(`${f.title} ${f.directors.join(' ')}`).includes(q)) &&
      multis.every((m) => {
        const values = chosen(m);
        const have = m.dataset.multi === 'provider' ? f.providers.map((p) => p.name) : f.genres;
        return !values.length || values.some((v) => have.includes(v));
      }) &&
      selects.every((sel) => {
        if (!sel.value) return true;
        if (sel.dataset.filter === 'runtime') {
          const [min, max] = sel.value.split('-').map(Number);
          return f.runtime != null && f.runtime >= min! && f.runtime <= max!;
        }
        return f.vote != null && f.vote >= Number(sel.value);
      });

    const byTitle = (a: SeenMovie, b: SeenMovie) => a.title.localeCompare(b.title, 'it', { sensitivity: 'base', numeric: true });
    /** Senza il dato (voto o anno) in fondo. */
    const nullsLast = (a: number | null, b: number | null, dir: 1 | -1) => (a == null ? (b == null ? 0 : 1) : b == null ? -1 : (a - b) * dir);
    const sorters: Record<string, (a: SeenMovie, b: SeenMovie) => number> = {
      titolo: byTitle,
      voto: (a, b) => nullsLast(a.vote, b.vote, -1) || byTitle(a, b),
      'anno-desc': (a, b) => nullsLast(a.year, b.year, -1) || byTitle(a, b),
      'anno-asc': (a, b) => nullsLast(a.year, b.year, 1) || byTitle(a, b),
    };

    /** Spunta di una lista per il film: tolta da tutte le sue chiavi (basta una per contarlo), messa sulla prima. */
    const tick = (f: SeenMovie, target: string, on: boolean) => {
      changingHere = true;
      setTicks(target, on ? [f.keys[0]!] : f.keys, on);
      changingHere = false;
    };
    const checkbox = (text: string, title: string, checked: boolean, onChange: (on: boolean) => void) => {
      const label = el('label', 'inline-flex cursor-pointer items-center gap-1.5 text-xs font-medium text-gray-700 select-none dark:text-gray-300');
      const box = el('input', 'size-3.5 cursor-pointer accent-emerald-600');
      box.type = 'checkbox';
      box.checked = checked;
      box.addEventListener('change', () => onChange(box.checked));
      label.append(box, text, el('span', 'sr-only', `: ${title}`));
      return { label, box };
    };

    const row = (f: SeenMovie) => {
      const li = el('li', 'flex items-start gap-3 px-3 py-3');
      const cover = el('div', 'h-21 w-14 shrink-0 overflow-hidden rounded bg-gray-200 ring-1 ring-black/10 sm:h-30 sm:w-20 dark:bg-gray-800 dark:ring-white/10');
      if (f.poster) {
        const img = el('img', 'h-full w-full object-cover');
        Object.assign(img, { src: f.poster, alt: '', width: 80, height: 120, loading: 'lazy', decoding: 'async', referrerPolicy: 'no-referrer' });
        img.addEventListener('error', () => img.remove()); // resta il riquadro grigio
        cover.append(img);
      }
      const text = el('div', 'min-w-0');
      const titleClass = 'cursor-pointer text-left font-semibold break-words decoration-indigo-400 underline-offset-2 hover:text-indigo-700 hover:underline dark:hover:text-indigo-300';
      const pageKey = f.keys.find((k) => inPage.has(k));
      if (pageKey) {
        // Film anche nelle classifiche della pagina: si apre la stessa scheda.
        const btn = el('button', `movie-open ${titleClass}`, f.title);
        btn.type = 'button';
        btn.dataset.film = pageKey;
        btn.setAttribute('aria-haspopup', 'dialog');
        text.append(btn);
      } else if (f.tmdbId > 0) {
        const a = el('a', titleClass, f.title);
        Object.assign(a, { href: `https://www.themoviedb.org/movie/${f.tmdbId}`, target: '_blank', rel: 'noopener' });
        a.setAttribute('aria-label', `${f.title} su TMDB (si apre in una nuova scheda)`);
        text.append(a);
      } else text.append(el('p', 'font-semibold break-words', f.title));
      const who = [f.directors.join(', '), f.year ? `(${f.year})` : ''].filter(Boolean).join(' ');
      if (who) text.append(el('p', 'text-gray-600 break-words dark:text-gray-400', who));
      const details = [f.runtime ? `${f.runtime} min` : '', f.genres.slice(0, 3).join(', ')].filter(Boolean).join(' · ');
      if (details) text.append(el('p', 'text-xs text-gray-500 dark:text-gray-400', details));
      if (f.tmdbId < 0) text.append(el('p', 'text-xs text-gray-500 italic dark:text-gray-400', 'Scheda non più disponibile: il film non è più nelle classifiche.'));

      if (f.vote || f.providers.length) {
        const line = el('div', 'mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1.5');
        if (f.vote) {
          const badge = el('span', 'inline-flex items-center gap-1 rounded-md bg-amber-50 px-1.5 py-0.5 text-xs font-semibold text-amber-900 tabular-nums ring-1 ring-amber-200 dark:bg-amber-950/60 dark:text-amber-200 dark:ring-amber-900');
          badge.title = `Voto medio su TMDB (${f.votes.toLocaleString('it-IT')} voti)`;
          badge.innerHTML = '<svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"></path></svg><span class="sr-only">Voto TMDB</span>';
          badge.append(voteText(f.vote));
          line.append(badge);
        }
        if (f.providers.length) {
          const names = f.providers.map((p) => p.name).join(', ');
          const box = el('span', 'inline-flex items-center gap-1');
          box.title = `In abbonamento su ${names}`;
          box.append(el('span', 'sr-only', `In abbonamento su ${names}`));
          for (const p of f.providers.slice(0, 4)) {
            if (p.logo) {
              const img = el('img', 'h-6 w-6 rounded-md ring-1 ring-black/10 dark:ring-white/10');
              Object.assign(img, { src: p.logo, alt: '', width: 24, height: 24, loading: 'lazy', referrerPolicy: 'no-referrer' });
              box.append(img);
            } else box.append(el('span', 'rounded-md bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-gray-800', p.name));
          }
          if (f.providers.length > 4) {
            const extra = el('span', 'text-xs text-gray-600 dark:text-gray-400', `+${f.providers.length - 4}`);
            extra.setAttribute('aria-hidden', 'true');
            box.append(extra);
          }
          line.append(box);
        }
        text.append(line);
      }

      const checks = el('div', 'mt-1 flex flex-wrap gap-x-4 gap-y-1');
      const keep = (on: boolean) => {
        if (on) removedHere.delete(f.tmdbId);
        else removedHere.add(f.tmdbId);
      };
      if (store === SEEN) {
        checks.append(
          checkbox('Visto', f.title, has(f, getTicks(SEEN)), (on) => {
            keep(on);
            tick(f, SEEN, on);
            countText();
          }).label,
        );
      } else {
        const watch = checkbox('Da vedere', f.title, has(f, getTicks(WATCH)), (on) => {
          keep(on);
          tick(f, WATCH, on);
          countText();
        });
        // Visto: il film esce dalla lista "da vedere" (resta in elenco, spuntato, fino al prossimo cambio di filtri).
        const seen = checkbox('Visto', f.title, has(f, getTicks(SEEN)), (on) => {
          tick(f, SEEN, on);
          if (on && watch.box.checked) {
            watch.box.checked = false;
            keep(false);
            tick(f, WATCH, false);
          }
          li.classList.toggle('bg-emerald-50', on);
          li.classList.toggle('dark:bg-emerald-950/40', on);
          countText();
        });
        li.classList.toggle('bg-emerald-50', seen.box.checked);
        li.classList.toggle('dark:bg-emerald-950/40', seen.box.checked);
        checks.append(watch.label, seen.label);
      }
      text.append(checks);

      li.append(cover, text);
      return li;
    };

    let shown: SeenMovie[] = [];
    const countText = () => {
      const ticks = getTicks(store);
      const total = mine.filter((f) => has(f, ticks)).length;
      const what = store === SEEN ? 'visti' : 'da vedere';
      count.textContent = shown.length === mine.length ? `${total} film ${what}` : `${shown.length} su ${mine.length} film`;
    };

    const render = () => {
      const q = normalizeText(search.value);
      shown = mine.filter((f) => passes(f, q)).sort(sorters[sort.value] ?? byTitle);
      list.replaceChildren(...shown.slice(0, limit).map(row));
      empty.classList.toggle('hidden', shown.length > 0);
      const rest = shown.length - limit;
      more.classList.toggle('hidden', rest <= 0);
      more.textContent = `Mostra altri ${Math.min(rest, PAGE)} (${Math.max(rest, 0)} ancora)`;
      for (const m of multis) {
        const values = chosen(m);
        m.querySelector('[data-multi-label]')!.textContent =
          values.length === 0 ? m.dataset.all! : values.length === 1 ? values[0]! : `${values[0]} +${values.length - 1}`;
      }
      reset.classList.toggle('hidden', !selects.some((s) => s.value) && !multis.some((m) => chosen(m).length));
      countText();
    };
    /** Ricerca, filtri o ordinamento cambiati: si riparte dalla prima pagina, senza i film appena tolti. */
    const changed = () => {
      limit = PAGE;
      if (removedHere.size) {
        removedHere.clear();
        collect();
      }
      render();
    };

    const emptyText = () =>
      store === SEEN
        ? 'Non hai ancora film segnati come visti: spunta "Visto" nelle classifiche o importa le tue spunte dalla pagina Account.'
        : 'La tua lista è vuota: spunta "Da vedere" accanto ai film delle classifiche Cinema e Film.';
    const showAll = () => {
      collect();
      const any = mine.length > 0;
      status.hidden = any;
      body.hidden = !any;
      if (!any) status.textContent = emptyText();
      buildOptions();
      render();
    };

    search.addEventListener('input', changed);
    sort.addEventListener('change', () => {
      writePref(sortKey, sort.value);
      changed();
    });
    for (const s of selects) s.addEventListener('change', changed);
    reset.addEventListener('click', () => {
      for (const s of selects) s.value = '';
      for (const b of root.querySelectorAll('[aria-pressed=true]')) b.setAttribute('aria-pressed', 'false');
      changed();
    });
    more.addEventListener('click', () => {
      limit += PAGE;
      render();
    });
    // Menu a scelta multipla: chiusi con Esc o con un clic fuori.
    document.addEventListener('click', (ev) => {
      for (const m of multis) if (m.open && !m.contains(ev.target as Node)) m.open = false;
    });
    root.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      const open = multis.find((m) => m.open);
      if (open) {
        open.open = false;
        open.querySelector('summary')!.focus();
      }
    });
    // Spunte cambiate altrove (classifica, scheda del film, altro dispositivo): elenco e filtri aggiornati.
    document.addEventListener(TICK_EVENT, (ev) => {
      const changedStore = (ev as CustomEvent<TickChange>).detail.store;
      if (changingHere || !loaded || (changedStore !== store && changedStore !== SEEN)) return;
      showAll();
    });

    let started = false;
    let loaded = false;
    const start = async () => {
      if (started) return;
      started = true;
      try {
        const res = await fetch(root.dataset.src!);
        if (!res.ok) throw new Error(String(res.status));
        films = ((await res.json()) as { films: SeenMovie[] }).films;
      } catch {
        status.textContent = 'Non è stato possibile caricare la lista: riprova più tardi.';
        started = false;
        return;
      }
      loaded = true;
      showAll();
    };
    if (panel) {
      // Scheda della pagina Film: si scarica solo quando viene aperta.
      new MutationObserver(() => {
        if (!panel.hidden) void start();
      }).observe(panel, { attributes: true, attributeFilter: ['hidden'] });
      if (!panel.hidden) void start();
    } else void start();
  }
</script>
