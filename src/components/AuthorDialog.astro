---
// Modale con la scheda di un autore: si apre dai nomi nella classifica Libri, nelle liste di libri curate e
// nella scheda del libro (pulsanti .author-open[data-autore]). I dati degli autori della pagina sono incorporati come JSON.
import { artistKey, splitArtists } from '../lib/aggregate';
import { getAuthorInfo } from '../lib/data';
import type { AuthorCard, BookItem } from '../lib/types';

interface Props {
  books: BookItem[];
  /** Titolo dell'elenco dei libri dell'autore presenti nella pagina. */
  booksLabel?: string;
}
const { books, booksLabel = 'In questa classifica' } = Astro.props;

const authors: Record<string, AuthorCard> = {};
for (const e of books)
  splitArtists(e.author ?? '', (n) => Boolean(getAuthorInfo(artistKey(n))?.wiki)).forEach((name, i) => {
    if (i % 2 === 1 || !name.trim() || /^autori vari$/i.test(name.trim())) return;
    const key = artistKey(name);
    const a = (authors[key] ??= { name: name.trim(), info: getAuthorInfo(key), books: [] });
    if (!a.books.some((b) => b.key === e.key)) a.books.push({ key: e.key, title: e.title });
  });
---

<script type="application/json" id="author-data" set:html={JSON.stringify(authors).replace(/</g, '\\u003c')} />

<dialog
  id="author-dialog"
  aria-labelledby="author-name"
  class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-2xl bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm dark:bg-gray-900 dark:text-gray-100"
>
  <div data-scroll class="relative flex max-h-[90dvh] flex-col overflow-y-auto sm:flex-row">
    <button
      type="button"
      data-close
      class="absolute top-2 right-2 z-10 rounded-full bg-white/80 p-2 text-gray-700 hover:bg-white dark:bg-gray-900/80 dark:text-gray-200 dark:hover:bg-gray-800"
      aria-label="Chiudi"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>

    <figure class="shrink-0 px-5 pt-5 sm:w-64 sm:bg-gray-100 sm:p-0 dark:sm:bg-gray-800">
      <img
        id="author-photo"
        alt=""
        referrerpolicy="no-referrer"
        class="mx-auto aspect-[4/5] w-40 rounded-lg object-cover object-top shadow-md sm:w-full sm:rounded-none sm:shadow-none"
      />
      <div id="author-photo-empty" class="mx-auto flex aspect-square w-32 items-center justify-center rounded-full bg-gray-100 text-4xl font-bold text-gray-400 sm:mt-8 sm:w-40 dark:bg-gray-800 sm:dark:bg-gray-700" aria-hidden="true"></div>
      <figcaption id="author-photo-credit" class="mt-1 text-center text-[11px] leading-snug text-gray-500 sm:px-3 sm:pb-3 sm:text-left dark:text-gray-400">
        Foto: <span id="author-photo-author"></span>,{' '}
        <a id="author-photo-license" class="underline" rel="noopener license" target="_blank"></a>,{' '}
        via <a id="author-photo-page" class="underline" rel="noopener" target="_blank">Wikimedia Commons</a>
      </figcaption>
    </figure>

    <div class="min-w-0 flex-1 space-y-4 p-5 sm:p-6">
      <h2 id="author-name" class="pr-8 text-2xl leading-tight font-bold break-words"></h2>

      <div>
        <div id="author-desc" class="space-y-2 text-sm leading-relaxed text-gray-800 dark:text-gray-200"></div>
        <p id="author-desc-source" class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          Da <a id="author-wiki" class="underline" rel="noopener" target="_blank"></a>, testo disponibile con licenza{' '}
          <a class="underline" href="https://creativecommons.org/licenses/by-sa/4.0/deed.it" rel="noopener license" target="_blank">CC BY-SA 4.0</a>.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400">{booksLabel}</h3>
        <ul id="author-books" class="mt-1 flex flex-wrap gap-1.5 text-sm"></ul>
      </div>

      <div class="flex flex-wrap gap-2 text-sm font-medium">
        <a id="author-apple" class="rounded-lg bg-indigo-600 px-3 py-2 text-white hover:bg-indigo-700" rel="noopener" target="_blank">Su Apple Books</a>
        <a id="author-search" class="rounded-lg border border-gray-300 px-3 py-2 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" rel="noopener" target="_blank">Altri libri su Google Libri</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { setParagraphs, setupDialog } from '../lib/dialogs';
  import type { AuthorCard } from '../lib/types';

  const dialog = document.querySelector<HTMLDialogElement>('#author-dialog');
  const dataEl = document.querySelector('#author-data');
  if (dialog && dataEl) {
    const authors = JSON.parse(dataEl.textContent || '{}') as Record<string, AuthorCard>;
    const $ = <T extends HTMLElement>(id: string) => dialog.querySelector<T>(`#${id}`)!;
    const setLink = (el: HTMLAnchorElement, url: string, label: string) => {
      el.href = url;
      el.setAttribute('aria-label', `${label} (si apre in una nuova scheda)`);
    };

    const render = (key: string) => {
      const a = authors[key];
      if (!a) return false;
      const info = a.info;
      $('author-name').textContent = a.name;

      const photo = info?.photo;
      const img = $<HTMLImageElement>('author-photo');
      img.hidden = !photo;
      img.src = photo?.src ?? '';
      img.alt = photo ? `Foto di ${a.name}` : '';
      $('author-photo-credit').hidden = !photo;
      if (photo) {
        $('author-photo-author').textContent = photo.author;
        const lic = $<HTMLAnchorElement>('author-photo-license');
        lic.textContent = photo.license;
        if (photo.licenseUrl) lic.href = photo.licenseUrl;
        else lic.removeAttribute('href');
        $<HTMLAnchorElement>('author-photo-page').href = photo.page;
      }
      const empty = $('author-photo-empty');
      empty.hidden = Boolean(photo);
      empty.textContent = a.name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');

      const desc = $('author-desc');
      const wiki = info?.wiki;
      if (wiki) {
        setParagraphs(desc, wiki.extract);
        if (wiki.lang === 'en') desc.lang = 'en';
        else desc.removeAttribute('lang');
        const link = $<HTMLAnchorElement>('author-wiki');
        link.href = wiki.url;
        link.textContent = `Wikipedia${wiki.lang === 'en' ? ' in inglese' : ''}, voce «${wiki.title}»`;
      } else {
        setParagraphs(
          desc,
          info ? 'Non abbiamo trovato una biografia di questo autore.' : 'La scheda di questo autore non è ancora disponibile: sarà completata nei prossimi aggiornamenti.',
          'text-gray-600 dark:text-gray-400',
        );
        desc.removeAttribute('lang');
      }
      $('author-desc-source').hidden = !wiki;

      $('author-books').replaceChildren(
        ...a.books.map((b) => {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'book-open cursor-pointer rounded-full bg-gray-100 px-3 py-1 hover:bg-indigo-50 hover:text-indigo-700 dark:bg-gray-800 dark:hover:bg-indigo-950 dark:hover:text-indigo-300';
          btn.dataset.libro = b.key;
          btn.setAttribute('aria-haspopup', 'dialog');
          btn.textContent = b.title;
          li.append(btn);
          return li;
        }),
      );

      const apple = $<HTMLAnchorElement>('author-apple');
      apple.hidden = !info?.appleUrl;
      if (info?.appleUrl) setLink(apple, info.appleUrl, `${a.name} su Apple Books`);
      setLink($<HTMLAnchorElement>('author-search'), `https://www.google.com/search?tbm=bks&q=${encodeURIComponent(`inauthor:"${a.name}"`)}`, `Altri libri di ${a.name} su Google Libri`);
      return true;
    };

    // Link diretto a un autore: /libri/#autore=<chiave>
    setupDialog({ dialog, name: 'autore', trigger: 'author-open', render });
  }
</script>
