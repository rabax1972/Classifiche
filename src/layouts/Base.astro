---
import '../styles/global.css';
import { href } from '../lib/data';
import { CATEGORIES } from '../lib/sources';
import { CATEGORY_IDS, type CategoryId, type CuratedId } from '../lib/types';

interface Props {
  title: string;
  description?: string;
  current?: CategoryId | CuratedId | 'fonti';
}
const { title, description = 'Le classifiche italiane di canzoni, libri, cinema, film e serie TV, aggiornate ogni giorno.', current } = Astro.props;
const CURATED_NAV: { id: CuratedId; label: string }[] = [
  { id: 'album-da-avere', label: 'Album da avere' },
  { id: 'libri-da-avere', label: 'Libri da avere' },
];
const fullTitle = title === 'Classifiche Italia' ? title : `${title} · Classifiche Italia`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      // Applica il tema prima del rendering per evitare il lampeggio.
      (() => {
        let t = null;
        try { t = localStorage.getItem('tema'); } catch {}
        const dark = t ? t === 'scuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900"
      >Vai al contenuto</a
    >
    <header class="border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-900/90">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href={href()} class="flex items-center gap-2 text-lg font-bold tracking-tight">
          <img src={href('favicon.svg')} alt="" width="28" height="28" />
          Classifiche Italia
        </a>
        <nav aria-label="Categorie" class="order-3 -mx-4 w-full overflow-x-auto px-4 sm:order-none sm:mx-0 sm:w-auto sm:px-0">
          <ul class="flex gap-1 text-sm font-medium">
            {
              CATEGORY_IDS.map((id) => (
                <li>
                  <a
                    href={href(id)}
                    aria-current={current === id ? 'page' : undefined}
                    class="block whitespace-nowrap rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300"
                  >
                    {CATEGORIES[id].label}
                  </a>
                </li>
              ))
            }
            {
              CURATED_NAV.map(({ id, label }) => (
                <li>
                  <a
                    href={href(id)}
                    aria-current={current === id ? 'page' : undefined}
                    class="block whitespace-nowrap rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button
          id="tema"
          type="button"
          class="ml-auto rounded-md p-2 text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
          aria-label="Attiva tema scuro"
        >
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
    </header>

    <main id="contenuto" class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200 py-8 text-sm text-gray-600 dark:border-gray-800 dark:text-gray-400">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-2">
          <p>
            Dati da Apple Music, Apple Books, Netflix Top 10, FIMI (via Wikipedia, CC BY-SA), Last.fm, TMDB, Cover Art Archive e Open Library.{' '}
            <a href={href('fonti')} class="font-medium text-indigo-700 underline dark:text-indigo-300">Fonti e metodo</a>.
          </p>
          <p class="flex items-center gap-2">
            <a href="https://www.themoviedb.org/" class="shrink-0" aria-label="The Movie Database (TMDB)">
              <img
                src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
                alt="TMDB"
                width="70"
                height="10"
                class="h-2.5 w-auto"
              />
            </a>
            <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
          </p>
        </div>
        <p class="sm:text-right">Progetto non commerciale.<br />Marchi e copertine appartengono ai rispettivi titolari.</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('tema')!;
      const sync = () => {
        const dark = document.documentElement.classList.contains('dark');
        btn.setAttribute('aria-label', dark ? 'Attiva tema chiaro' : 'Attiva tema scuro');
      };
      sync();
      btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('tema', dark ? 'scuro' : 'chiaro');
        } catch {}
        sync();
      });
    </script>
  </body>
</html>
