---
import '../styles/global.css';
import { href } from '../lib/data';
import { CATEGORIES } from '../lib/sources';
import { CATEGORY_IDS, type CategoryId, type CuratedId } from '../lib/types';

interface Props {
  title: string;
  description?: string;
  current?: CategoryId | CuratedId | 'fonti' | 'account' | 'da-vedere' | 'libri-letti';
}
const { title, description = 'Le classifiche italiane di canzoni, libri, cinema, film e serie TV, aggiornate ogni giorno.', current } = Astro.props;
const CURATED_NAV: { id: CuratedId; label: string }[] = [
  { id: 'album-da-avere', label: 'Album da avere' },
  { id: 'libri-da-avere', label: 'Libri da avere' },
];
const fullTitle = title === 'Classifiche Italia' ? title : `${title} · Classifiche Italia`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      // Applica il tema prima del rendering per evitare il lampeggio.
      (() => {
        let t = null;
        try { t = localStorage.getItem('tema'); } catch {}
        const dark = t ? t === 'scuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900"
      >Vai al contenuto</a
    >
    <header class="border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-900/90">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href={href()} class="flex items-center gap-2 text-lg font-bold tracking-tight">
          <img src={href('favicon.svg')} alt="" width="28" height="28" />
          Classifiche Italia
        </a>
        <nav aria-label="Categorie" class="order-3 -mx-4 w-full overflow-x-auto px-4 sm:order-none sm:mx-0 sm:w-auto sm:px-0">
          <ul class="flex gap-1 text-sm font-medium">
            {
              CATEGORY_IDS.map((id) => (
                <li>
                  <a
                    href={href(id)}
                    aria-current={current === id ? 'page' : undefined}
                    class="block whitespace-nowrap rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300"
                  >
                    {CATEGORIES[id].label}
                  </a>
                </li>
              ))
            }
            {
              CURATED_NAV.map(({ id, label }) => (
                <li>
                  <a
                    href={href(id)}
                    aria-current={current === id ? 'page' : undefined}
                    class="block whitespace-nowrap rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          id="watch-link"
          href={href('da-vedere')}
          aria-current={current === 'da-vedere' ? 'page' : undefined}
          title="I film che hai segnato da vedere"
          class="ml-auto flex items-center gap-1.5 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
          <span class="sr-only sm:not-sr-only">Da vedere</span>
          <!-- Numero di film nella lista (src/lib/ticks.ts), aggiornato a ogni spunta. -->
          <span data-watch-count hidden class="rounded-full bg-indigo-600 px-1.5 text-xs leading-5 font-semibold text-white tabular-nums dark:bg-indigo-400 dark:text-indigo-950"></span>
        </a>
        <a
          id="account-link"
          href={href('account')}
          aria-current={current === 'account' ? 'page' : undefined}
          class="group flex items-center gap-1.5 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 aria-[current=page]:bg-indigo-50 aria-[current=page]:text-indigo-700 data-logged:rounded-full data-logged:bg-emerald-50 data-logged:py-1 data-logged:pr-3 data-logged:pl-1 data-logged:text-emerald-900 data-logged:ring-1 data-logged:ring-emerald-300 data-logged:hover:bg-emerald-100 dark:text-gray-300 dark:hover:bg-gray-800 dark:aria-[current=page]:bg-indigo-950 dark:aria-[current=page]:text-indigo-300 dark:data-logged:bg-emerald-950/60 dark:data-logged:text-emerald-200 dark:data-logged:ring-emerald-800 dark:data-logged:hover:bg-emerald-950"
        >
          <svg class="h-5 w-5 group-data-logged:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
          <!-- Con l'account: avatar con l'iniziale e il nome dell'indirizzo (src/lib/account.ts). -->
          <span
            data-account-avatar
            class="relative hidden h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white uppercase group-data-logged:flex dark:bg-emerald-500 dark:text-emerald-950"
            aria-hidden="true"
          ></span>
          <span class="sr-only" data-account-sr></span>
          <span data-account-label class="max-w-[9rem] truncate">Accedi</span>
        </a>
        <button
          id="tema"
          type="button"
          class="rounded-md p-2 text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
          aria-label="Attiva tema scuro"
        >
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
    </header>

    <main id="contenuto" class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200 py-8 text-sm text-gray-600 dark:border-gray-800 dark:text-gray-400">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-2">
          <p>
            Dati da Apple Music, Apple Books, Netflix Top 10, FIMI (via Wikipedia, CC BY-SA), Last.fm, TMDB, Cover Art Archive e Open Library.{' '}
            <a href={href('fonti')} class="font-medium text-indigo-700 underline dark:text-indigo-300">Fonti e metodo</a>.
          </p>
          <p class="flex items-center gap-2">
            <a href="https://www.themoviedb.org/" class="shrink-0" aria-label="The Movie Database (TMDB)">
              <img
                src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
                alt="TMDB"
                width="70"
                height="10"
                class="h-2.5 w-auto"
              />
            </a>
            <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
          </p>
        </div>
        <p class="sm:text-right">
          Progetto non commerciale.<br />Marchi e copertine appartengono ai rispettivi titolari.<br />
          <a href={href('privacy')} class="font-medium text-indigo-700 underline dark:text-indigo-300">Privacy</a>
        </p>
      </div>
    </footer>

    <script>
      import { ACCOUNT_EVENT, cachedAccount, type Account } from '../lib/account';
      import { TICK_EVENT, getTicks, startSync } from '../lib/ticks';

      // Intestazione: "Accedi" oppure, con l'account, un avatar con l'iniziale e il nome dell'indirizzo (l'indirizzo intero nel suggerimento).
      const accountLink = document.getElementById('account-link')!;
      const showAccount = (account: Account | null) => {
        const name = account?.email.split('@')[0] ?? '';
        accountLink.toggleAttribute('data-logged', Boolean(account));
        accountLink.querySelector('[data-account-avatar]')!.textContent = name.charAt(0);
        accountLink.querySelector('[data-account-sr]')!.textContent = account ? 'Account collegato: ' : '';
        accountLink.querySelector('[data-account-label]')!.textContent = account ? name : 'Accedi';
        accountLink.title = account ? `Collegato come ${account.email}` : 'Accedi o crea un account per salvare le spunte';
      };
      showAccount(cachedAccount());
      document.addEventListener(ACCOUNT_EVENT, (ev) => showAccount((ev as CustomEvent<Account | null>).detail));
      // Intestazione: quanti film ci sono nella lista "Da vedere".
      const watchCount = document.querySelector<HTMLElement>('[data-watch-count]')!;
      const showWatchCount = () => {
        const n = getTicks('da-vedere').size;
        watchCount.hidden = n === 0;
        watchCount.textContent = String(n);
      };
      showWatchCount();
      document.addEventListener(TICK_EVENT, showWatchCount);
      startSync();

      const btn = document.getElementById('tema')!;
      const sync = () => {
        const dark = document.documentElement.classList.contains('dark');
        btn.setAttribute('aria-label', dark ? 'Attiva tema chiaro' : 'Attiva tema scuro');
      };
      sync();
      btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('tema', dark ? 'scuro' : 'chiaro');
        } catch {}
        sync();
      });
    </script>
  </body>
</html>
