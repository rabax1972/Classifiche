<?xml version="1.0" encoding="UTF-8"?>
<!--
  Regole per IIS (hosting Windows di Aruba, cartella /classifiche del dominio): qui il .htaccess non viene applicato.
  Aggiornamento automatico (public/api/_inc/aggiornamenti.php): il PHP può scrivere solo in mdb-database, quindi i file aggiornati
  dal workflow di GitHub stanno in mdb-database/sito/ e, quando esistono, li serve api/sito.php al posto di quelli statici.
  Se il sito cambia cartella, cambiano anche gli URL "/classifiche/..." qui sotto.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Pagina nuova che esiste solo tra gli aggiornamenti: /classifiche/pagina → /classifiche/pagina/ (IIS lo fa da solo per le cartelle vere). -->
        <rule name="Aggiornamenti: barra finale" stopProcessing="true">
          <match url="^(.+[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}mdb-database\sito\{R:1}\index.html" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="/classifiche/{R:1}/" redirectType="Found" />
        </rule>
        <rule name="Aggiornamenti: pagine" stopProcessing="true">
          <match url="^(.*/)?$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}mdb-database\sito\{R:0}index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/classifiche/api/sito.php?f={R:0}index.html" />
        </rule>
        <rule name="Aggiornamenti: file" stopProcessing="true">
          <match url="^.*[^/]$" />
          <conditions>
            <add input="{R:0}" pattern="^api/" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}mdb-database\sito\{R:0}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/classifiche/api/sito.php?f={R:0}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
